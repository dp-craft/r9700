       1 // FILE: impl.ts
       2 export function createAsyncMemo<K, V>(fn: (key: K) => Promise<V>): (key: K) => Promise<V> {
       3   const cache = new Map<K, Promise<V>>();
       4   return (key: K): Promise<V> => {
       5     const cached = cache.get(key);
       6     if (cached !== undefined) return cached;
       7     const pending = fn(key).catch((err: unknown): never => {
       8       cache.delete(key);
       9       throw err;
      10     });
