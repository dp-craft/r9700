# campaign.env — this campaign's defaults for bench/quality/run_capture.sh <this dir>.
# Sourced line-by-line: a variable already set in the environment (a caller override) always wins,
# so these values are only applied where nothing was set beforehand. One KEY=value per line.
TITLE=Ornith-1.0-35B vs Gemma-4-31B-it-qat at 128k
JUDGE_ENGINE=none    # scaffold default (old copy): capture+grade+charts only — set JUDGE_ENGINE=claude-tmux to judge
SUMMARY=0            # scaffold default (old copy): write-up via /benchmark-results after review — set 1 to auto-draft
MODELS_DIR=/home/dev/models/gguf
REPS=3
CALIB=calibration-reps.jsonl
# summary-prompt.md (beside this file): the SUMMARY=1 write-up prompt with this campaign's own questions
