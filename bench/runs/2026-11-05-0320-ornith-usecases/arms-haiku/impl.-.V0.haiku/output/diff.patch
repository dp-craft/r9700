+/**
+ * Error thrown by `parse` for a malformed line and by `format` for an invalid key.
+ * `column` is the 0-based index of the offending character in the line, or -1 from `format`.
+ */
+export class LogfmtError extends Error {
+  column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = "LogfmtError";
+    this.column = column;
+  }
+}
+
+const isBlank = (c: string): boolean => c === " " || c === "\t";
+
+function skipBlanks(line: string, i: number): number {
+  while (i < line.length && isBlank(line.charAt(i))) i++;
+  return i;
+}
+
+/** Reads the quoted value whose opening quote is at `open`. */
+function readQuoted(line: string, open: number): { text: string; end: number } {
+  let text = "";
+  let i = open + 1;
+  while (i < line.length) {
+    const c = line.charAt(i);
+    if (c === '"') return { text, end: i + 1 };
+    if (c !== "\\") {
+      text += c;
+      i++;
+      continue;
+    }
+    if (i + 1 >= line.length) break; // a dangling backslash can never close the quote
+    const e = line.charAt(i + 1);
+    if (e === '"' || e === "\\") text += e;
+    else if (e === "n") text += "\n";
+    else throw new LogfmtError(`unknown escape \\${e}`, i);
+    i += 2;
+  }
+  throw new LogfmtError("unterminated quoted value", open);
+}
+
+export function parse(line: string): Record<string, string | true> {
+  const out: Record<string, string | true> = {};
+  let i = skipBlanks(line, 0);
+  while (i < line.length) {
+    if (line.charAt(i) === "=") throw new LogfmtError("empty key", i);
+
+    const keyStart = i;
+    while (i < line.length && !isBlank(line.charAt(i)) && line.charAt(i) !== "=") i++;
+    const key = line.slice(keyStart, i);
+
+    let value: string | true = true;
+    if (line.charAt(i) === "=") {
+      i++;
+      if (line.charAt(i) === '"') {
+        const quoted = readQuoted(line, i);
+        if (quoted.end < line.length && !isBlank(line.charAt(quoted.end))) {
+          throw new LogfmtError("unexpected character after closing quote", quoted.end);
+        }
+        value = quoted.text;
+        i = quoted.end;
+      } else {
+        const valueStart = i;
+        while (i < line.length && !isBlank(line.charAt(i))) i++;
+        value = line.slice(valueStart, i);
+      }
+    }
+
+    // defineProperty instead of assignment, so a key such as "__proto__" is stored as an own property.
+    // Note: JS objects always enumerate integer-like keys ("1", "42") first, so for those keys
+    // the result cannot keep first-seen order.
+    Object.defineProperty(out, key, { value, enumerable: true, writable: true, configurable: true });
+    i = skipBlanks(line, i);
+  }
+  return out;
+}
+
+function formatValue(value: string): string {
+  if (value !== "" && !/[ \t"\\=\n]/.test(value)) return value;
+  const body = value.replace(/["\\\n]/g, (c) => (c === "\n" ? "\\n" : `\\${c}`));
+  return `"${body}"`;
+}
+
+export function format(fields: Record<string, string | true>): string {
+  return Object.entries(fields)
+    .map(([key, value]) => {
+      if (key === "" || /[ \t="]/.test(key)) {
+        throw new LogfmtError(`invalid key ${JSON.stringify(key)}`, -1);
+      }
+      return value === true ? key : `${key}=${formatValue(value)}`;
+    })
+    .join(" ");
+}
