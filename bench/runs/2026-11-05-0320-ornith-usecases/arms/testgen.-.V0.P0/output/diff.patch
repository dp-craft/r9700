diff --git a/tests/semver.test.ts b/tests/semver.test.ts
new file mode 100644
index 0000000..15fc5fe
--- /dev/null
+++ b/tests/semver.test.ts
@@ -0,0 +1,176 @@
+import { describe, it, expect } from "vitest";
+import { parse, SemVerError, compare, satisfiesCaret, bump, maxVersion } from "../src/semver";
+
+describe("parse", () => {
+  it("parses a plain version into its components", () => {
+    expect(parse("1.2.3")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("treats an absent prerelease as empty", () => {
+    expect(parse("0.0.0").pre).toEqual([]);
+  });
+
+  it("splits a single-part prerelease into one element", () => {
+    expect(parse("1.2.3-alpha")).toEqual({ major: 1, minor: 2, patch: 3, pre: ["alpha"] });
+  });
+
+  it("splits a multi-element prerelease on dots", () => {
+    expect(parse("1.2.3-alpha.1.beta")).toEqual({
+      major: 1,
+      minor: 2,
+      patch: 3,
+      pre: ["alpha", "1", "beta"],
+    });
+  });
+
+  it("parses large numeric components as numbers", () => {
+    const v = parse("10.200.3000");
+    expect(v).toEqual({ major: 10, minor: 200, patch: 3000, pre: [] });
+    expect(typeof v.major).toBe("number");
+  });
+
+  it.each(["1.2", "1.2.3.4", "x.y.z", "", "v1.2.3", "1.2.3-", "-1.2.3"])(
+    "throws a SemVerError on invalid input %j",
+    (s) => {
+      expect(() => parse(s)).toThrow(SemVerError);
+    },
+  );
+
+  it("exposes SemVerError as an Error subclass", () => {
+    const e = new SemVerError("boom");
+    expect(e).toBeInstanceOf(Error);
+    expect(e.message).toBe("boom");
+  });
+});
+
+describe("compare", () => {
+  it("returns 0 for equal versions", () => {
+    expect(compare("1.2.3", "1.2.3")).toBe(0);
+    expect(compare("0.0.0", "0.0.0")).toBe(0);
+  });
+
+  it("orders by major, then minor, then patch", () => {
+    expect(compare("1.0.0", "2.0.0")).toBe(-1);
+    expect(compare("2.0.0", "1.9.9")).toBe(1);
+    expect(compare("1.1.0", "1.0.9")).toBe(1);
+    expect(compare("1.0.0", "1.0.1")).toBe(-1);
+    expect(compare("1.2.0", "1.1.99")).toBe(1);
+  });
+
+  it("treats a prerelease as sorting before its release", () => {
+    expect(compare("1.0.0-alpha", "1.0.0")).toBe(-1);
+    expect(compare("1.0.0", "1.0.0-alpha")).toBe(1);
+  });
+
+  it("compares prerelease identifiers dot by dot", () => {
+    expect(compare("1.0.0-alpha", "1.0.0-beta")).toBe(-1);
+    expect(compare("1.0.0-beta", "1.0.0-alpha")).toBe(1);
+    expect(compare("1.0.0-alpha", "1.0.0-alphax")).toBe(-1);
+  });
+
+  it("ranks numeric identifiers lower than alphanumeric ones", () => {
+    // 1 before alpha, per semver (numeric < non-numeric).
+    expect(compare("1.0.0-1", "1.0.0-alpha")).toBe(-1);
+    expect(compare("1.0.0-alpha", "1.0.0-1")).toBe(1);
+  });
+
+  it("compares numeric identifiers by value", () => {
+    expect(compare("1.0.0-1", "1.0.0-2")).toBe(-1);
+    expect(compare("1.0.0-10", "1.0.0-9")).toBe(1);
+  });
+
+  it("orders by remaining identifiers and then shorter is lower", () => {
+    // common prefix, then a longer prerelease wins: alpha.1 < alpha.beta (numeric first)
+    expect(compare("1.0.0-alpha.1", "1.0.0-alpha.beta")).toBe(-1);
+    // equal up to the shorter length; the shorter one sorts before
+    expect(compare("1.0.0-alpha", "1.0.0-alpha.1")).toBe(-1);
+  });
+
+  it("is antisymmetric", () => {
+    const pairs = [
+      ["1.0.0", "2.0.0"],
+      ["1.0.0-alpha", "1.0.0"],
+      ["1.0.0-2", "1.0.0-10"],
+    ] as const;
+    for (const [a, b] of pairs) {
+      const ab = compare(a, b);
+      expect(ab).not.toBe(0);
+      expect(compare(b, a)).toBe(-ab);
+    }
+  });
+});
+
+describe("satisfiesCaret", () => {
+  it("accepts versions >= base while sharing the major when major > 0", () => {
+    expect(satisfiesCaret("1.2.3", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.9.9", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.0.0", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("2.0.0", "1.2.3")).toBe(false);
+  });
+
+  it("caps ^0.x.y at the next minor when minor > 0", () => {
+    expect(satisfiesCaret("0.2.3", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.2.99", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.3.0", "0.2.3")).toBe(false);
+    expect(satisfiesCaret("1.0.0", "0.2.3")).toBe(false);
+  });
+
+  it("accepts only the exact patch when both major and minor are 0", () => {
+    expect(satisfiesCaret("0.0.3", "0.0.3")).toBe(true);
+    expect(satisfiesCaret("0.0.4", "0.0.3")).toBe(false);
+    expect(satisfiesCaret("0.0.2", "0.0.3")).toBe(false);
+  });
+
+  it("rejects every prerelease against a plain base, since a prerelease sorts below its release", () => {
+    expect(satisfiesCaret("1.2.3-alpha", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("1.2.3-rc.1", "1.2.3")).toBe(false);
+  });
+
+  it("rejects a prerelease whose x.y.z differs from the base", () => {
+    expect(satisfiesCaret("2.0.0-rc.1", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("1.4.0-rc", "1.2.3")).toBe(false);
+  });
+
+  it("rejects versions below the base regardless of range", () => {
+    expect(satisfiesCaret("1.2.2", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("0.9.0", "1.2.3")).toBe(false);
+  });
+});
+
+describe("bump", () => {
+  it("increments each part and resets lower ones to zero", () => {
+    expect(bump("1.2.3", "patch")).toBe("1.2.4");
+    expect(bump("1.2.3", "minor")).toBe("1.3.0");
+    expect(bump("1.2.3", "major")).toBe("2.0.0");
+  });
+
+  it("resets from a fresh major boundary", () => {
+    expect(bump("9.9.9", "major")).toBe("10.0.0");
+    expect(bump("0.0.9", "patch")).toBe("0.0.10");
+  });
+
+  it("drops any prerelease before bumping", () => {
+    expect(bump("1.2.3-alpha.1", "patch")).toBe("1.2.4");
+    expect(bump("1.2.3-rc", "major")).toBe("2.0.0");
+  });
+});
+
+describe("maxVersion", () => {
+  it("returns the highest version from a list", () => {
+    expect(maxVersion(["1.0.0", "2.0.0", "1.5.0"])).toBe("2.0.0");
+    expect(maxVersion(["3.0.0", "3.0.0"])).toBe("3.0.0");
+  });
+
+  it("returns null for an empty list", () => {
+    expect(maxVersion([])).toBeNull();
+  });
+
+  it("prefers a full release over a prerelease with the same x.y.z", () => {
+    // 1.0.0-alpha < 1.0.0, so the release wins despite the "newer" numbering.
+    expect(maxVersion(["1.0.0", "1.0.0-alpha"])).toBe("1.0.0");
+  });
+
+  it("handles a single element", () => {
+    expect(maxVersion(["4.5.6"])).toBe("4.5.6");
+  });
+});
