+export class LogfmtError extends Error {
+  column: number;
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = "LogfmtError";
+    this.column = column;
+  }
+}
+
+const SEP = (c: string): boolean => c === ' ' || c === '\t';
+
+export function parse(line: string): Record<string, string | true> {
+  const out: Record<string, string | true> = {};
+  const n = line.length;
+  let i = 0;
+  while (i < n) {
+    while (i < n && SEP(line[i])) i++;
+    if (i >= n) break;
+
+    const keyStart = i;
+    while (i < n && line[i] !== '=' && !SEP(line[i])) i++;
+    const key = line.slice(keyStart, i);
+
+    // The key loop stops at '=', a separator, or end-of-line. Only '=' starts a value.
+    if (i < n && !SEP(line[i])) {
+      if (key.length === 0) {
+        throw new LogfmtError("empty key", i);
+      }
+      i++; // consume '='
+
+      if (i >= n) {
+        out[key] = '';
+        continue;
+      }
+
+      const c = line[i];
+      if (c === '"') {
+        const quotePos = i;
+        i++; // consume opening quote
+        let val = '';
+        while (i < n && line[i] !== '"') {
+          const ch = line[i];
+          if (ch === '\\') {
+            if (i + 1 >= n) throw new LogfmtError("unterminated", quotePos);
+            const next = line[i + 1];
+            if (next === '"') { val += '"'; i += 2; continue; }
+            if (next === '\\') { val += '\\'; i += 2; continue; }
+            if (next === 'n') { val += '\n'; i += 2; continue; }
+            throw new LogfmtError(`unknown escape \\${next}`, i);
+          }
+          val += ch;
+          i++;
+        }
+        if (i >= n) {
+          throw new LogfmtError("unterminated quote", quotePos);
+        }
+        i++; // consume closing quote
+        if (i < n && !SEP(line[i])) {
+          throw new LogfmtError(`non-whitespace after quote`, i);
+        }
+        out[key] = val;
+      } else {
+        const vstart = i;
+        while (i < n && !SEP(line[i])) i++;
+        out[key] = line.slice(vstart, i);
+      }
+    } else {
+      out[key] = true;
+    }
+  }
+  return out;
+}
+
+const NEEDS_QUOTE = /[ \t"\\=\n]/;
+
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+  for (const key of Object.keys(fields)) {
+    if (key.length === 0 || key.includes(' ') || key.includes('\t') || key.includes('=') || key.includes('"')) {
+      throw new LogfmtError("invalid key", -1);
+    }
+    const value = fields[key];
+    if (value === true) {
+      parts.push(key);
+    } else if (value.length === 0 || NEEDS_QUOTE.test(value)) {
+      parts.push(
+        `${key}="${value.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\n')}"`,
+      );
+    } else {
+      parts.push(`${key}=${value}`);
+    }
+  }
+  return parts.join(' ');
+}
