diff --git a/tests/semver.test.ts b/tests/semver.test.ts
new file mode 100644
index 0000000..7873366
--- /dev/null
+++ b/tests/semver.test.ts
@@ -0,0 +1,170 @@
+import { describe, it, expect } from "vitest";
+import { parse, SemVerError, compare, satisfiesCaret, bump, maxVersion } from "../src/semver";
+
+describe("parse", () => {
+  it("parses a plain version into its components", () => {
+    expect(parse("1.2.3")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("parses the numeric components as numbers", () => {
+    const v = parse("10.20.30");
+    expect(v).toEqual({ major: 10, minor: 20, patch: 30, pre: [] });
+    expect(typeof v.major).toBe("number");
+  });
+
+  it("splits a prerelease into identifiers", () => {
+    expect(parse("1.2.3-alpha.1")).toEqual({ major: 1, minor: 2, patch: 3, pre: ["alpha", "1"] });
+  });
+
+  it("handles dot/dash hyphenated prerelease identifiers", () => {
+    expect(parse("1.0.0-0.3.7")).toEqual({ major: 1, minor: 0, patch: 0, pre: ["0", "3", "7"] });
+    expect(parse("1.0.0-xzjqz.svfg-2")).toEqual({
+      major: 1,
+      minor: 0,
+      patch: 0,
+      pre: ["xzjqz", "svfg-2"],
+    });
+  });
+
+  it("throws SemVerError for malformed versions", () => {
+    expect(() => parse("1.2")).toThrow(SemVerError);
+    expect(() => parse("v1.2.3")).toThrow(SemVerError);
+    expect(() => parse("1.2.3.4")).toThrow(SemVerError);
+    expect(() => parse("a.b.c")).toThrow(SemVerError);
+    expect(() => parse("").toThrow(SemVerError));
+  });
+
+  it("accepts leading zeros (\\d+ matches them) without throwing", () => {
+    expect(parse("01.2.3")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("the thrown error carries a message and is an Error", () => {
+    const err = assertThrows(() => parse("nope"));
+    expect(err).toBeInstanceOf(Error);
+    expect(err).toBeInstanceOf(SemVerError);
+    expect(err.message).toContain("invalid version");
+  });
+});
+
+function assertThrows(fn: () => unknown): Error {
+  try {
+    fn();
+  } catch (err) {
+    return err as Error;
+  }
+  throw new Error("expected function to throw but it did not");
+}
+
+describe("compare", () => {
+  it("returns 0 for equal versions", () => {
+    expect(compare("1.2.3", "1.2.3")).toBe(0);
+    expect(compare("1.2.0", "1.2.0")).toBe(0);
+  });
+
+  it("orders by major, then minor, then patch", () => {
+    expect(compare("1.0.0", "2.0.0")).toBe(-1);
+    expect(compare("2.0.0", "1.9.9")).toBe(1);
+    expect(compare("1.1.0", "1.2.0")).toBe(-1);
+    expect(compare("1.3.5", "1.3.9")).toBe(-1);
+  });
+
+  it("sorts a prerelease before its release", () => {
+    expect(compare("1.2.3-alpha", "1.2.3")).toBe(-1);
+    expect(compare("1.2.3", "1.2.3-alpha")).toBe(1);
+  });
+
+  it("compares prerelease identifiers per the semver rules", () => {
+    // numeric identifiers compared numerically
+    expect(compare("1.0.0-1", "1.0.0-2")).toBe(-1);
+    expect(compare("1.0.0-2", "1.0.0-10")).toBe(-1);
+    // numeric < alphanumeric
+    expect(compare("1.0.0-alpha", "1.0.0-1")).toBe(1);
+    expect(compare("1.0.0-1", "1.0.0-alpha")).toBe(-1);
+    // alphanumeric compared lexically, field by field
+    expect(compare("1.0.0-alpha", "1.0.0-beta")).toBe(-1);
+    expect(compare("1.0.0-alpha.1", "1.0.0-alpha.2")).toBe(-1);
+  });
+
+  it("a longer prerelease with all matching lower parts sorts higher", () => {
+    expect(compare("1.0.0-alpha", "1.0.0-alpha.1")).toBe(-1);
+    expect(compare("1.0.0-alpha.1", "1.0.0-alpha.beta")).toBe(-1);
+    // more fields than the other, sharing prefix
+    expect(compare("1.0.0-1.2.3", "1.0.0-1.2")).toBe(1);
+  });
+});
+
+describe("satisfiesCaret", () => {
+  it("allows same major, any higher minor/patch above the base", () => {
+    expect(satisfiesCaret("1.5.0", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.99.99", "1.2.3")).toBe(true);
+  });
+
+  it("rejects versions below the base and of a lower major", () => {
+    expect(satisfiesCaret("1.0.0", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("0.9.9", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("2.0.0", "1.2.3")).toBe(false);
+  });
+
+  it("respects the ^0.2.x rule: only same major.minor within a new patch", () => {
+    expect(satisfiesCaret("0.2.9", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.3.0", "0.2.3")).toBe(false);
+  });
+
+  it("respects the ^0.0.x rule: only the exact base is allowed", () => {
+    expect(satisfiesCaret("0.0.3", "0.0.3")).toBe(true);
+    expect(satisfiesCaret("0.0.4", "0.0.3")).toBe(false);
+  });
+
+  it("requires the same x.y.z for prereleases of the base", () => {
+    // a prerelease sorts below its release, so 1.2.3-alpha does NOT satisfy ^1.2.3
+    expect(satisfiesCaret("1.2.3-alpha", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("1.2.4-alpha", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("1.2.3-alpha", "1.2.3-alpha")).toBe(true);
+  });
+});
+
+describe("bump", () => {
+  it("bumps major and resets the lower parts", () => {
+    expect(bump("1.2.3", "major")).toBe("2.0.0");
+    expect(bump("9.2.3", "major")).toBe("10.0.0");
+  });
+
+  it("bumps minor and resets patch", () => {
+    expect(bump("1.2.3", "minor")).toBe("1.3.0");
+  });
+
+  it("bumps patch", () => {
+    expect(bump("1.2.3", "patch")).toBe("1.2.4");
+    expect(bump("1.2.9", "patch")).toBe("1.2.10");
+  });
+
+  it("drops any prerelease when bumping", () => {
+    expect(bump("1.2.3-alpha.1", "patch")).toBe("1.2.4");
+    expect(bump("1.2.3-beta", "major")).toBe("2.0.0");
+  });
+
+  it("throws for an invalid version", () => {
+    expect(() => bump("not-a-version", "minor")).toThrow(SemVerError);
+  });
+});
+
+describe("maxVersion", () => {
+  it("returns null for an empty list", () => {
+    expect(maxVersion([])).toBeNull();
+  });
+
+  it("returns the highest version by compare order", () => {
+    expect(maxVersion(["1.0.0", "2.0.0", "1.5.0"])).toBe("2.0.0");
+    expect(maxVersion(["1.0.0", "1.1.0", "1.0.1"])).toBe("1.1.0");
+  });
+
+  it("treats a prerelease as lower than the release regardless of position", () => {
+    expect(maxVersion(["1.0.0", "1.0.0-alpha", "2.0.0-beta"])).toBe("2.0.0-beta");
+    expect(maxVersion(["1.0.0-beta", "1.0.0"])).toBe("1.0.0");
+  });
+
+  it("works on an unsorted list and returns one of the input strings", () => {
+    const list = ["3.1.4", "2.7.1", "3.1.4"];
+    expect(maxVersion(list)).toBe("3.1.4");
+  });
+});
