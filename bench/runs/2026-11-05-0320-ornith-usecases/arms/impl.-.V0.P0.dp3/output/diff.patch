+/**
+ * logfmt parser and formatter.
+ *
+ * A logfmt line is a sequence of `key=value` or bare `key` tokens separated by
+ * one or more spaces/tabs. This module round-trips: `parse(format(x))` equals `x`.
+ */
+
+export class LogfmtError extends Error {
+  readonly column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = "LogfmtError";
+    this.column = column;
+  }
+}
+
+/** A token separator is a space or a tab only. */
+const isSep = (c: string | undefined): boolean => c === " " || c === "\t";
+
+export function parse(line: string): Record<string, string | true> {
+  const n = line.length;
+  let i = 0;
+  // Map preserves first-seen insertion order and, when a key repeats, keeps its
+  // original slot while updating the value ("last wins").
+  const result = new Map<string, string | true>();
+
+  while (i < n) {
+    while (i < n && isSep(line[i])) i++;
+    if (i >= n) break;
+
+    // A key runs until '=', space, tab, or end of line.
+    let j = i;
+    while (j < n && line[j] !== "=" && !isSep(line[j])) j++;
+    const key = line.slice(i, j);
+    if (key.length === 0) {
+      // A pair starting with '=' has an empty key; point at the '='.
+      throw new LogfmtError("empty key", i);
+    }
+
+    if (j < n && line[j] === "=") {
+      let k = j + 1;
+      if (k >= n) {
+        result.set(key, "");
+        continue;
+      }
+      const first = line[k]!;
+      if (first === '"') {
+        let decoded = "";
+        let p = k + 1;
+        while (true) {
+          if (p >= n) throw new LogfmtError("unterminated quoted value", k);
+          const ch = line[p]!;
+          if (ch === '"') {
+            // The character after the closing quote must be a separator or EOF.
+            const nx = line[p + 1];
+            if (nx !== undefined && !isSep(nx)) {
+              throw new LogfmtError("unexpected character after quoted value", p + 1);
+            }
+            i = p + 1;
+            break;
+          }
+          if (ch === "\\") {
+            const esc = line[p + 1];
+            if (esc === '"') { decoded += '"'; p += 2; }
+            else if (esc === "\\") { decoded += "\\"; p += 2; }
+            else if (esc === "n") { decoded += "\n"; p += 2; }
+            else throw new LogfmtError("unknown escape sequence", p);
+          } else {
+            decoded += ch;
+            p += 1;
+          }
+        }
+        result.set(key, decoded);
+      } else {
+        // Bare value runs until the next separator (covers the empty `key=` case).
+        let m = k;
+        while (m < n && !isSep(line[m])) m++;
+        result.set(key, line.slice(k, m));
+        i = m;
+      }
+    } else {
+      result.set(key, true);
+      i = j;
+    }
+  }
+
+  const out: Record<string, string | true> = {};
+  for (const [key, value] of result) out[key] = value;
+  return out;
+}
+
+function quoteValue(value: string): string {
+  // Escape backslash first so later escapes don't double up.
+  return value
+    .replace(/\\/g, "\\\\")
+    .replace(/"/g, '\\"')
+    .replace(/\n/g, "\\n");
+}
+
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+  for (const key of Object.keys(fields)) {
+    if (key === "" || /[ \t="]/.test(key)) {
+      throw new LogfmtError("invalid key", -1);
+    }
+    const value = fields[key];
+    if (value === true) {
+      parts.push(key);
+    } else if (/[\t"\\= ]/.test(value) || value.includes("\n") || value.length === 0) {
+      parts.push(`"${quoteValue(value)}"`);
+    } else {
+      parts.push(value);
+    }
+  }
+  return parts.join(" ");
+}
