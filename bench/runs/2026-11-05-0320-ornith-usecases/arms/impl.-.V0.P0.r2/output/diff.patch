+export class LogfmtError extends Error {
+  column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = "LogfmtError";
+    this.column = column;
+  }
+}
+
+const isSep = (c: string | undefined): boolean => c === " " || c === "\t";
+
+export function parse(line: string): Record<string, string | true> {
+  const order = new Map<string, string | true>();
+  let i = 0;
+  const n = line.length;
+
+  while (i < n) {
+    while (i < n && isSep(line[i])) i++;
+    if (i >= n) break;
+
+    const keyStart = i;
+    while (i < n && line[i] !== "=" && !isSep(line[i])) i++;
+    const key = line.slice(keyStart, i);
+
+    if (key.length === 0) {
+      throw new LogfmtError("empty key", i);
+    }
+
+    if (i >= n || line[i] !== "=") {
+      order.set(key, true);
+      continue;
+    }
+
+    i++; // consume '='
+    if (i < n && line[i] === '"') {
+      let value = "";
+      const quoteStart = i;
+      i++; // consume opening quote
+      let closed = false;
+      while (i < n) {
+        const c = line[i];
+        if (c === "\\") {
+          if (i + 1 >= n) break; // dangling escape -> unterminated below
+          const next = line[i + 1];
+          if (next === '"') {
+            value += '"';
+            i += 2;
+          } else if (next === "\\") {
+            value += "\\";
+            i += 2;
+          } else if (next === "n") {
+            value += "\n";
+            i += 2;
+          } else {
+            throw new LogfmtError("unknown escape", i);
+          }
+        } else if (c === '"') {
+          i++; // consume closing quote
+          closed = true;
+          break;
+        } else {
+          value += c;
+          i++;
+        }
+      }
+      if (!closed) throw new LogfmtError("unterminated quote", quoteStart);
+
+      if (i < n && !isSep(line[i])) {
+        throw new LogfmtError("content after quoted value", i);
+      }
+      order.set(key, value);
+    } else {
+      const valStart = i;
+      while (i < n && !isSep(line[i])) i++;
+      order.set(key, line.slice(valStart, i));
+    }
+  }
+
+  return Object.fromEntries(order);
+}
+
+const KEY_RE = /[ \t="]/;
+const VALUE_RE = /[ \t"\\=\n]/;
+
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+
+  for (const key of Object.keys(fields)) {
+    if (key.length === 0 || KEY_RE.test(key)) {
+      throw new LogfmtError("invalid key", -1);
+    }
+  }
+
+  for (const [key, value] of Object.entries(fields)) {
+    if (value === true) {
+      parts.push(key);
+    } else {
+      const text = value;
+      if (text.length === 0 || VALUE_RE.test(text)) {
+        parts.push(
+          '"' +
+            text.replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\n/g, "\\n") +
+            '"'
+        );
+      } else {
+        parts.push(text);
+      }
+    }
+  }
+
+  return parts.join(" ");
+}
