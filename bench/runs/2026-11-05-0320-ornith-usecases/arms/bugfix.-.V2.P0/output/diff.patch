diff --git a/tests/test_movstats.py b/tests/test_movstats.py
index 5a9a6bb..86d46eb 100644
--- a/tests/test_movstats.py
+++ b/tests/test_movstats.py
@@ -7,3 +7,30 @@ def test_rolling_max():
 
 def test_rolling_median_reported():
     assert rolling_median([1, 2, 3, 4], 2) == [1.5, 2.5, 3.5]
+
+
+def test_rolling_median_second_series_is_not_cached():
+    # Symptom 2: a different series with the same window must not reuse the
+    # first series' cached numbers.
+    assert rolling_median([1, 2], 2) == [1.5]
+    assert rolling_median([10, 20], 2) == [15.0]
+
+
+def test_rolling_median_window_one():
+    # Window of 1: median of a single element is the element itself.
+    assert rolling_median([5, 3, 8], 1) == [5, 3, 8]
+
+
+def test_rolling_median_odd_window():
+    # Odd window: middle element of sorted [1, 2, 3].
+    assert rolling_median([1, 3, 2], 3) == [2]
+
+
+def test_rolling_median_last_window_included():
+    # The final full window must be present (off-by-one fix).
+    assert rolling_median([1, 2, 3, 4], 2)[-1] == 3.5
+
+
+def test_rolling_median_shorter_than_window():
+    # Input shorter than the window yields no full windows.
+    assert rolling_median([1, 2], 3) == []
