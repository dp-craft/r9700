+/**
+ * logfmt parsing and formatting.
+ *
+ * See SPEC.md for the full contract. In brief:
+ *   - `parse(line)` turns a logfmt line into an ordered record of pairs.
+ *   - `format(record)` renders a record back into a logfmt line.
+ *   - `LogfmtError` carries the 0-based `column` of an offending character.
+ */
+
+export class LogfmtError extends Error {
+  column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.column = column;
+    this.name = "LogfmtError";
+    Object.setPrototypeOf(this, new.target.prototype);
+  }
+}
+
+/** Whitespace that separates logfmt pairs: space or tab. */
+function isSeparator(c: string | undefined): boolean {
+  return c === " " || c === "\t";
+}
+
+export function parse(line: string): Record<string, string | true> {
+  const n = line.length;
+  let i = 0;
+  // A Map preserves first-seen insertion order and de-duplicates keys, with
+  // the last assignment winning on repeat.
+  const map = new Map<string, string | true>();
+
+  while (i < n) {
+    // Skip one or more separator runs between pairs.
+    while (i < n && isSeparator(line[i])) i++;
+    if (i >= n) break;
+
+    const keyStart = i;
+    while (i < n && line[i] !== "=" && !isSeparator(line[i])) i++;
+    const key = line.slice(keyStart, i);
+
+    // A pair starting with "=" has an empty key.
+    if (key === "") {
+      throw new LogfmtError("empty key", keyStart);
+    }
+
+    // No value: bare key maps to `true`.
+    if (i >= n || isSeparator(line[i])) {
+      map.set(key, true);
+      continue;
+    }
+
+    // line[i] === "=". Consume it and read the value.
+    i++;
+    const afterEquals = line[i];
+    if (afterEquals === '"') {
+      const quoteStart = i;
+      i++;
+      const buf: string[] = [];
+      while (true) {
+        if (i >= n) {
+          throw new LogfmtError("unterminated quoted value", quoteStart);
+        }
+        const c = line[i];
+        if (c === "\\") {
+          const next = line[i + 1]; // undefined when the backslash is last
+          if (next === '"' || next === "\\" || next === "n") {
+            buf.push(next === "n" ? "\n" : next);
+            i += 2;
+          } else {
+            throw new LogfmtError("unknown escape", i);
+          }
+        } else if (c === '"') {
+          i++; // consume closing quote
+          break;
+        } else {
+          buf.push(c);
+          i++;
+        }
+      }
+      // A non-whitespace character right after the closing quote is illegal.
+      if (i < n && !isSeparator(line[i])) {
+        throw new LogfmtError("unexpected character after quoted value", i);
+      }
+      map.set(key, buf.join(""));
+    } else {
+      // Bare value: runs until the next separator or end of line.
+      const valStart = i;
+      while (i < n && !isSeparator(line[i])) i++;
+      map.set(key, line.slice(valStart, i));
+    }
+  }
+
+  return Object.fromEntries(map);
+}
+
+/** True when a bare value must be quoted to survive a round trip. */
+function needsQuoting(value: string): boolean {
+  for (const ch of value) {
+    if (
+      ch === " " ||
+      ch === "\t" ||
+      ch === '"' ||
+      ch === "\\" ||
+      ch === "=" ||
+      ch === "\n"
+    ) {
+      return true;
+    }
+  }
+  return false;
+}
+
+function encodeQuotedValue(value: string): string {
+  let out = "";
+  for (const ch of value) {
+    if (ch === "\\") out += "\\\\";
+    else if (ch === '"') out += '\\"';
+    else if (ch === "\n") out += "\\n";
+    else out += ch;
+  }
+  return out;
+}
+
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+  for (const key of Object.keys(fields)) {
+    if (key === "" || /[ \t="]/.test(key)) {
+      throw new LogfmtError("invalid key", -1);
+    }
+
+    const value = fields[key];
+    if (value === true) {
+      parts.push(key);
+    } else {
+      const stringValue = typeof value === "string" ? value : String(value);
+      if (stringValue === "" || needsQuoting(stringValue)) {
+        parts.push(`${key}="${encodeQuotedValue(stringValue)}"`);
+      } else {
+        parts.push(`${key}=${stringValue}`);
+      }
+    }
+  }
+  return parts.join(" ");
+}
