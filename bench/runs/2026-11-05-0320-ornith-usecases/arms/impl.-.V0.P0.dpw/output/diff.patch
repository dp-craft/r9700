+/**
+ * logfmt parsing and formatting.
+ *
+ * A "pair" is either a bare key or a `key=value`. Pairs are separated by one
+ * or more spaces or tabs. Values may be bare (runs until the next space/tab)
+ * or double-quoted (with `\"`, `\\` and `\n` escapes decoded).
+ */
+
+/** An error raised while parsing or formatting, with a 0-based offending column. */
+export class LogfmtError extends Error {
+  public column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = 'LogfmtError';
+    this.column = column;
+    // Keep `instanceof` working if this class is down-leveled by a bundler.
+    Object.setPrototypeOf(this, new.target.prototype);
+  }
+}
+
+const WHITESPACE = (c: string): boolean => c === ' ' || c === '\t';
+
+/** Parse a single logfmt line into an ordered map of key to value. */
+export function parse(line: string): Record<string, string | true> {
+  const result: Record<string, string | true> = {};
+  const n = line.length;
+  let i = 0;
+
+  while (i < n) {
+    // Skip the separator(s) before a pair.
+    while (i < n && WHITESPACE(line[i]!)) i++;
+    if (i >= n) break;
+
+    // Scan the key: anything up to the next `=`, space or tab.
+    const start = i;
+    while (i < n && line[i] !== '=' && !WHITESPACE(line[i]!)) i++;
+    const key = line.slice(start, i);
+
+    // No `=`: a bare flag with value true. (Short-circuit keeps `i < n` here.)
+    if (i >= n || WHITESPACE(line[i]!)) {
+      result[key] = true;
+      continue;
+    }
+
+    // line[i] === '='
+    if (key === '') {
+      throw new LogfmtError('empty key', i);
+    }
+
+    const qPos = i + 1;
+    if (qPos < n && line[qPos]! === '"') {
+      // Quoted value.
+      let val = '';
+      let j = qPos + 1;
+      let terminated = false;
+      while (j < n) {
+        const c = line[j]!;
+        if (c === '"') {
+          j++;
+          terminated = true;
+          break;
+        }
+        if (c === '\\') {
+          if (j + 1 >= n) {
+            throw new LogfmtError('unterminated quote', qPos);
+          }
+          const next = line[j + 1]!;
+          if (next === '"') {
+            val += '"';
+            j += 2;
+          } else if (next === '\\') {
+            val += '\\';
+            j += 2;
+          } else if (next === 'n') {
+            val += '\n';
+            j += 2;
+          } else {
+            throw new LogfmtError('unknown escape', j);
+          }
+        } else {
+          val += c;
+          j++;
+        }
+      }
+      if (!terminated) {
+        throw new LogfmtError('unterminated quote', qPos);
+      }
+      // A non-whitespace character right after the closing quote is illegal.
+      if (j < n && !WHITESPACE(line[j]!)) {
+        throw new LogfmtError('unexpected char after quote', j);
+      }
+      result[key] = val;
+      i = j;
+    } else {
+      // Bare value: runs until the next space or tab. May contain `=`.
+      let j = i + 1;
+      while (j < n && !WHITESPACE(line[j]!)) j++;
+      result[key] = line.slice(i + 1, j);
+      i = j;
+    }
+  }
+
+  return result;
+}
+
+const NEEDS_QUOTING = /[ \t"\\=\n]/;
+
+/** Format an ordered map of key/value pairs back into a logfmt line. */
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+
+  for (const key of Object.keys(fields)) {
+    if (key === '' || /[ \t"=]/.test(key)) {
+      throw new LogfmtError('invalid key', -1);
+    }
+
+    // `key` came from Object.keys(fields), so its property is always present.
+    const value = fields[key]!;
+    if (value === true) {
+      parts.push(key);
+      continue;
+    }
+
+    if (value.length === 0 || NEEDS_QUOTING.test(value)) {
+      const encoded = value
+        .replace(/\\/g, '\\\\')
+        .replace(/"/g, '\\"')
+        .replace(/\n/g, '\\n');
+      // Only the value is quoted; the key stays bare: key="value".
+      parts.push(key + '="' + encoded + '"');
+    } else {
+      parts.push(`${key}=${value}`);
+    }
+  }
+
+  return parts.join(' ');
+}
