+// Logfmt parsing and formatting.
+
+/** Error thrown by parse/format with the 0-based column of the offending character. */
+export class LogfmtError extends Error {
+  column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.column = column;
+    Object.setPrototypeOf(this, new.target.prototype);
+    this.name = "LogfmtError";
+  }
+}
+
+function isSpace(ch: string | undefined): boolean {
+  return ch === " " || ch === "\t";
+}
+
+interface Value {
+  value: string;
+  next: number;
+}
+
+// Read a quoted value starting at `start` (the character after the opening quote).
+function readQuoted(line: string, start: number): Value {
+  const n = line.length;
+  let i = start;
+  const openColumn = start - 1;
+  const buf: string[] = [];
+
+  while (i < n) {
+    const c = line[i];
+    if (c === '"') {
+      return { value: buf.join(""), next: i + 1 };
+    } else if (c === "\\") {
+      const esc = line[i + 1];
+      if (esc === '"') {
+        buf.push('"');
+        i += 2;
+      } else if (esc === "\\") {
+        buf.push("\\");
+        i += 2;
+      } else if (esc === "n") {
+        buf.push("\n");
+        i += 2;
+      } else {
+        throw new LogfmtError("unknown escape", i);
+      }
+    } else {
+      buf.push(c ?? "");
+      i++;
+    }
+  }
+
+  throw new LogfmtError("unterminated string", openColumn);
+}
+
+// Read a bare value from `start` until the next space, tab, or end of line.
+function readBare(line: string, start: number): Value {
+  const n = line.length;
+  let i = start;
+  while (i < n && !isSpace(line[i])) {
+    i++;
+  }
+  return { value: line.slice(start, i), next: i };
+}
+
+export function parse(line: string): Record<string, string | true> {
+  const map = new Map<string, string | true>();
+  const n = line.length;
+  let i = 0;
+
+  while (i < n) {
+    // Skip one or more separators.
+    while (i < n && isSpace(line[i])) {
+      i++;
+    }
+    if (i >= n) {
+      break;
+    }
+
+    // Read the key up to '=', space, tab, or end of line.
+    const keyStart = i;
+    while (i < n && !isSpace(line[i]) && line[i] !== "=") {
+      i++;
+    }
+    const key = line.slice(keyStart, i);
+
+    // With whitespace already skipped, an empty key means the token starts with '='.
+    if (key.length === 0) {
+      throw new LogfmtError("empty key", i);
+    }
+
+    if (i < n && line[i] === "=") {
+      const valueStart = i + 1; // position after '='
+      let next: number;
+      let value: string | true;
+
+      if (valueStart < n && line[valueStart] === '"') {
+        const quoted = readQuoted(line, valueStart + 1);
+        next = quoted.next;
+        value = quoted.value;
+      } else {
+        const bare = readBare(line, valueStart);
+        next = bare.next;
+        value = bare.value;
+      }
+
+      // After a quoted value the following character must be whitespace or end of line.
+      if (valueStart < n && line[valueStart] === '"' && !(next >= n || isSpace(line[next]))) {
+        throw new LogfmtError("text after closing quote", next);
+      }
+
+      map.set(key, value);
+      i = next;
+    } else {
+      // Key at end of line with no '='.
+      map.set(key, true);
+    }
+  }
+
+  const out: Record<string, string | true> = {};
+  for (const [k, v] of map) {
+    out[k] = v;
+  }
+  return out;
+}
+
+function needsQuote(v: string): boolean {
+  if (v === "") {
+    return true;
+  }
+  for (let k = 0; k < v.length; k++) {
+    const c = v[k];
+    if (c === " " || c === "\t" || c === '"' || c === "\\" || c === "=" || c === "\n") {
+      return true;
+    }
+  }
+  return false;
+}
+
+function encodeQuoted(v: string): string {
+  let out = "";
+  for (let k = 0; k < v.length; k++) {
+    const c = v[k];
+    if (c === "\\") {
+      out += "\\\\";
+    } else if (c === '"') {
+      out += '\\"';
+    } else if (c === "\n") {
+      out += "\\n";
+    } else {
+      out += c;
+    }
+  }
+  return out;
+}
+
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+
+  for (const key of Object.keys(fields)) {
+    if (key === "" || /[ \t="]/.test(key)) {
+      throw new LogfmtError("invalid key", -1);
+    }
+
+    const value = fields[key]!;
+    if (value === true) {
+      parts.push(key);
+    } else if (needsQuote(value)) {
+      parts.push(`${key}="${encodeQuoted(value)}"`);
+    } else {
+      parts.push(`${key}=${value}`);
+    }
+  }
+
+  return parts.join(" ");
+}
