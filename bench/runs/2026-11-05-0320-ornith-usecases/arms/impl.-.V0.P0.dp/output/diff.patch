+/**
+ * logfmt parser and formatter.
+ *
+ * @see SPEC.md for the full contract that this module implements.
+ */
+
+/** An error carrying the 0-based column of the offending character. */
+export class LogfmtError extends Error {
+  column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = "LogfmtError";
+    this.column = column;
+    // Keep instanceof working across transpilation targets.
+    Object.setPrototypeOf(this, new.target.prototype);
+  }
+}
+
+/** Is the given separator character (space or tab) at position `i`? */
+const isSep = (c: string | undefined): boolean => c === " " || c === "\t";
+
+/** Decode a quoted value beginning at the opening quote (`line[i]`). */
+function decodeQuoted(line: string, i: number, n: number): { value: string; next: number } {
+  const open = i; // position of the opening quote, used for "unterminated" errors
+  i++;
+  let value = "";
+  for (;;) {
+    if (i >= n) {
+      throw new LogfmtError("unterminated quoted value", open);
+    }
+    const c = line[i]!;
+    if (c === '"') {
+      i++; // consume closing quote
+      return { value, next: i };
+    }
+    if (c === "\\") {
+      const esc = line[i + 1];
+      if (esc === undefined) {
+        throw new LogfmtError("unknown escape", i);
+      }
+      switch (esc) {
+        case '"': value += '"'; break;
+        case "\\": value += "\\"; break;
+        case "n": value += "\n"; break;
+        default: throw new LogfmtError("unknown escape", i);
+      }
+      i += 2;
+    } else {
+      value += c;
+      i++;
+    }
+  }
+}
+
+/**
+ * Parse a single logfmt line into a key/value record. Keys keep their first-seen
+ * insertion order; repeated keys take the last value.
+ */
+export function parse(line: string): Record<string, string | true> {
+  const result: Record<string, string | true> = {};
+  const n = line.length;
+  let i = 0;
+
+  while (i < n) {
+    // Skip one or more separators between pairs.
+    while (i < n && isSep(line[i])) i++;
+    if (i >= n) break;
+
+    const start = i;
+    let key = "";
+    while (i < n && line[i] !== "=" && !isSep(line[i])) {
+      key += line[i]!;
+      i++;
+    }
+
+    // A pair beginning with `=` has an empty key.
+    if (key === "") {
+      throw new LogfmtError("empty key", start);
+    }
+
+    if (i < n && line[i] === "=") {
+      i++; // consume '='
+      if (i >= n) {
+        result[key] = ""; // `key=` -> empty string
+      } else if (line[i] === '"') {
+        const { value, next } = decodeQuoted(line, i, n);
+        // A non-separator character after the closing quote is an error.
+        if (next < n && !isSep(line[next])) {
+          throw new LogfmtError("trailing characters after quoted value", next);
+        }
+        result[key] = value;
+        i = next;
+      } else {
+        // Bare value: runs until the next separator, may contain '='.
+        let value = "";
+        while (i < n && !isSep(line[i])) {
+          value += line[i]!;
+          i++;
+        }
+        result[key] = value;
+      }
+    } else {
+      result[key] = true; // bare key with no '='
+    }
+  }
+
+  return result;
+}
+
+/** Does this value need to be quoted in the formatted output? */
+function needsQuoting(value: string): boolean {
+  if (value === "") return true;
+  for (let i = 0; i < value.length; i++) {
+    const c = value[i]!;
+    if (c === " " || c === "\t" || c === '"' || c === "\\" || c === "=" || c === "\n") {
+      return true;
+    }
+  }
+  return false;
+}
+
+/** Escape the three characters that must be encoded inside a quoted value. */
+function quoteValue(value: string): string {
+  let out = '"';
+  for (let i = 0; i < value.length; i++) {
+    const c = value[i]!;
+    if (c === "\\") out += "\\\\";
+    else if (c === '"') out += '\\"';
+    else if (c === "\n") out += "\\n";
+    else out += c;
+  }
+  return out + '"';
+}
+
+/**
+ * Format a record back into a logfmt line, joining pairs with one space in
+ * insertion order. Throws for keys that are empty or contain a space, tab, `=`,
+ * or `"`.
+ */
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+  for (const key of Object.keys(fields)) {
+    if (key === "" || key.includes(" ") || key.includes("\t") || key.includes("=") || key.includes('"')) {
+      throw new LogfmtError("invalid key", -1);
+    }
+
+    const value: string | true = fields[key]!;
+    if (value === true) {
+      parts.push(key);
+    } else if (needsQuoting(value)) {
+      parts.push(`${key}=${quoteValue(value)}`);
+    } else {
+      parts.push(`${key}=${value}`);
+    }
+  }
+  return parts.join(" ");
+}
