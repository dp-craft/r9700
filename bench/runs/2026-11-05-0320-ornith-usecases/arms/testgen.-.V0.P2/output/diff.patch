diff --git a/tests/semver.test.ts b/tests/semver.test.ts
new file mode 100644
index 0000000..4f1fd93
--- /dev/null
+++ b/tests/semver.test.ts
@@ -0,0 +1,231 @@
+import { describe, expect, it } from "vitest";
+import {
+  SemVerError,
+  bump,
+  compare,
+  maxVersion,
+  parse,
+  satisfiesCaret,
+} from "../src/semver";
+
+describe("parse", () => {
+  it("parses a plain version with an empty prerelease", () => {
+    expect(parse("1.2.3")).toEqual({
+      major: 1,
+      minor: 2,
+      patch: 3,
+      pre: [],
+    });
+  });
+
+  it("parses zero", () => {
+    expect(parse("0.0.0")).toEqual({
+      major: 0,
+      minor: 0,
+      patch: 0,
+      pre: [],
+    });
+  });
+
+  it("parses large numeric identifiers", () => {
+    expect(parse("10.200.3000")).toEqual({
+      major: 10,
+      minor: 200,
+      patch: 3000,
+      pre: [],
+    });
+  });
+
+  it("splits a prerelease into dot-separated identifiers", () => {
+    expect(parse("1.2.3-alpha.1")).toEqual({
+      major: 1,
+      minor: 2,
+      patch: 3,
+      pre: ["alpha", "1"],
+    });
+  });
+
+  it("keeps dots and hyphens inside a single prerelease identifier", () => {
+    expect(parse("1.2.3-alpha.1.beta-2")).toEqual({
+      major: 1,
+      minor: 2,
+      patch: 3,
+      pre: ["alpha", "1", "beta-2"],
+    });
+  });
+
+  it("parses a prerelease with only numeric identifiers", () => {
+    expect(parse("1.0.0-1")).toEqual({
+      major: 1,
+      minor: 0,
+      patch: 0,
+      pre: ["1"],
+    });
+  });
+
+  it("throws SemVerError on a missing patch", () => {
+    expect(() => parse("1.2")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError on a non-numeric identifier", () => {
+    expect(() => parse("a.b.c")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError on an empty string", () => {
+    expect(() => parse("")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError on a four-part version", () => {
+    expect(() => parse("1.2.3.4")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError when a segment is empty", () => {
+    expect(() => parse("1..3")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError on a leading operator", () => {
+    expect(() => parse("^1.2.3")).toThrow(SemVerError);
+  });
+});
+
+describe("compare", () => {
+  it("returns 0 for equal versions", () => {
+    expect(compare("1.2.3", "1.2.3")).toBe(0);
+  });
+
+  it("compares major numerically", () => {
+    expect(compare("2.0.0", "1.9.9")).toBe(1);
+    expect(compare("1.0.0", "2.0.0")).toBe(-1);
+  });
+
+  it("compares minor numerically when major is equal", () => {
+    expect(compare("1.2.0", "1.10.0")).toBe(-1);
+    expect(compare("1.10.0", "1.2.0")).toBe(1);
+  });
+
+  it("compares patch numerically when major and minor are equal", () => {
+    expect(compare("1.2.3", "1.2.10")).toBe(-1);
+    expect(compare("1.2.10", "1.2.3")).toBe(1);
+  });
+
+  it("a prerelease sorts before its release", () => {
+    expect(compare("1.0.0-alpha", "1.0.0")).toBe(-1);
+    expect(compare("1.0.0", "1.0.0-alpha")).toBe(1);
+  });
+
+  it("a shorter prerelease sorts before a longer one with the same prefix", () => {
+    expect(compare("1.0.0-alpha", "1.0.0-alpha.1")).toBe(-1);
+  });
+
+  it("compares prerelease identifiers lexically when both are non-numeric", () => {
+    expect(compare("1.0.0-alpha", "1.0.0-beta")).toBe(-1);
+    expect(compare("1.0.0-beta", "1.0.0-alpha")).toBe(1);
+  });
+
+  it("a numeric identifier sorts before a non-numeric one", () => {
+    // Per semver: identifiers consisting of only digits have lower precedence.
+    expect(compare("1.0.0-1", "1.0.0-alpha")).toBe(-1);
+  });
+
+  it("compares numeric prerelease identifiers numerically", () => {
+    expect(compare("1.0.0-beta.2", "1.0.0-beta.11")).toBe(-1);
+    expect(compare("1.0.0-beta.11", "1.0.0-beta.2")).toBe(1);
+  });
+
+  it("is symmetric", () => {
+    const a = "1.0.0-rc.1";
+    const b = "1.0.0-rc.2";
+    expect(compare(a, b)).toBe(-compare(b, a));
+  });
+
+  it("throws on an invalid version", () => {
+    expect(() => compare("1.2", "1.2.3")).toThrow(SemVerError);
+  });
+});
+
+describe("satisfiesCaret", () => {
+  it("allows anything below the next major for a major >= 1 base", () => {
+    expect(satisfiesCaret("1.2.3", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.9.9", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.0.0", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("2.0.0", "1.2.3")).toBe(false);
+  });
+
+  it("allows anything below the next minor for a 0.minor base", () => {
+    expect(satisfiesCaret("0.2.3", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.2.9", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.3.0", "0.2.3")).toBe(false);
+    expect(satisfiesCaret("1.0.0", "0.2.3")).toBe(false);
+  });
+
+  it("allows only the exact version for a 0.0.base", () => {
+    expect(satisfiesCaret("0.0.3", "0.0.3")).toBe(true);
+    expect(satisfiesCaret("0.0.4", "0.0.3")).toBe(false);
+    expect(satisfiesCaret("0.0.2", "0.0.3")).toBe(false);
+  });
+
+  it("rejects a prerelease whose x.y.z differs from the base", () => {
+    expect(satisfiesCaret("1.2.4-alpha", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("1.3.0-alpha", "1.2.3")).toBe(false);
+  });
+
+  it("rejects a prerelease even when it shares the base x.y.z", () => {
+    // A prerelease sorts below its release, so compare() puts it below base.
+    expect(satisfiesCaret("1.2.3-alpha", "1.2.3")).toBe(false);
+  });
+
+  it("rejects versions below the base", () => {
+    expect(satisfiesCaret("1.2.2", "1.2.3")).toBe(false);
+  });
+});
+
+describe("bump", () => {
+  it("bumps major and resets lower parts", () => {
+    expect(bump("1.2.3", "major")).toBe("2.0.0");
+  });
+
+  it("bumps minor and resets patch", () => {
+    expect(bump("1.2.3", "minor")).toBe("1.3.0");
+  });
+
+  it("bumps patch", () => {
+    expect(bump("1.2.3", "patch")).toBe("1.2.4");
+  });
+
+  it("drops an existing prerelease when bumping", () => {
+    expect(bump("1.2.3-alpha.1", "major")).toBe("2.0.0");
+    expect(bump("1.2.3-alpha.1", "minor")).toBe("1.3.0");
+    expect(bump("1.2.3-alpha.1", "patch")).toBe("1.2.4");
+  });
+
+  it("bumps from zero", () => {
+    expect(bump("0.0.0", "minor")).toBe("0.1.0");
+    expect(bump("0.0.0", "major")).toBe("1.0.0");
+  });
+
+  it("throws on an invalid version", () => {
+    expect(() => bump("1.2", "patch")).toThrow(SemVerError);
+  });
+});
+
+describe("maxVersion", () => {
+  it("returns null for an empty list", () => {
+    expect(maxVersion([])).toBeNull();
+  });
+
+  it("returns the highest version", () => {
+    expect(maxVersion(["1.2.3", "1.2.4", "1.3.0"])).toBe("1.3.0");
+  });
+
+  it("handles an unordered list", () => {
+    expect(maxVersion(["0.0.1", "1.0.0", "0.5.0"])).toBe("1.0.0");
+  });
+
+  it("treats a release as higher than its prerelease", () => {
+    expect(maxVersion(["1.0.0-alpha", "1.0.0"])).toBe("1.0.0");
+  });
+
+  it("handles a single element", () => {
+    expect(maxVersion(["4.5.6"])).toBe("4.5.6");
+  });
+});
