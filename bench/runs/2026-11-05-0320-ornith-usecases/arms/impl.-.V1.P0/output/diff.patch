+export class LogfmtError extends Error {
+  readonly column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.column = column;
+    Object.setPrototypeOf(this, LogfmtError.prototype);
+  }
+}
+
+function isSpaceOrTab(c: string | undefined): boolean {
+  return c === ' ' || c === '\t';
+}
+
+// '=' delimits a key from its value, so it also terminates a bare key run.
+function isKeyTerminator(c: string | undefined): boolean {
+  return c === '=' || isSpaceOrTab(c);
+}
+
+export function parse(line: string): Record<string, string | true> {
+  const result: Record<string, string | true> = {};
+  const n = line.length;
+  let i = 0;
+
+  while (i < n) {
+    while (i < n && isSpaceOrTab(line[i])) i++;
+    if (i >= n) break;
+
+    const pairStart = i;
+    let keyEnd = i;
+    while (keyEnd < n && !isKeyTerminator(line[keyEnd])) keyEnd++;
+
+    // Bare key: nothing follows up to whitespace, or no '=' present.
+    if (line[keyEnd] !== '=') {
+      result[line.slice(pairStart, keyEnd)] = true;
+      i = keyEnd;
+      continue;
+    }
+
+    const eqIndex = keyEnd;
+    if (eqIndex === pairStart) {
+      throw new LogfmtError('empty key', eqIndex);
+    }
+
+    const key = line.slice(pairStart, eqIndex);
+    i = eqIndex + 1;
+
+    // `key=` or `key<space>` yields the empty string.
+    if (i >= n || isSpaceOrTab(line[i])) {
+      result[key] = '';
+      continue;
+    }
+
+    if (line[i] === '"') {
+      const quoteStart = i;
+      let value = '';
+      i++; // past opening quote
+      while (i < n) {
+        const c = line[i];
+        if (c === '"') {
+          i++; // past closing quote
+          break;
+        }
+        if (c === '\\') {
+          const escIndex = i;
+          i++;
+          if (i >= n) {
+            throw new LogfmtError('unterminated quote', quoteStart);
+          }
+          switch (line[i]) {
+            case '"': value += '"'; break;
+            case '\\': value += '\\'; break;
+            case 'n': value += '\n'; break;
+            default: throw new LogfmtError('unknown escape', escIndex);
+          }
+          i++;
+        } else {
+          value += c;
+          i++;
+        }
+      }
+      if (i >= n) {
+        throw new LogfmtError('unterminated quote', quoteStart);
+      }
+      // After a closing quote only whitespace may follow.
+      if (!isSpaceOrTab(line[i])) {
+        throw new LogfmtError('unexpected char after quote', i);
+      }
+      result[key] = value;
+    } else {
+      // Bare value: runs until the next space or tab; may contain '='.
+      let vEnd = i;
+      while (vEnd < n && !isSpaceOrTab(line[vEnd])) vEnd++;
+      result[key] = line.slice(i, vEnd);
+      i = vEnd;
+    }
+  }
+
+  return result;
+}
+
+function assertValidKey(key: string): void {
+  if (key.length === 0) {
+    throw new LogfmtError('empty key', -1);
+  }
+  for (const c of key) {
+    if (c === ' ' || c === '\t' || c === '=' || c === '"') {
+      throw new LogfmtError('invalid key', -1);
+    }
+  }
+}
+
+function needsQuoting(v: string): boolean {
+  for (const c of v) {
+    if (c === ' ' || c === '\t' || c === '"' || c === '\\' || c === '=' || c === '\n') {
+      return true;
+    }
+  }
+  return false;
+}
+
+function escapeQuoted(v: string): string {
+  let out = '';
+  for (const c of v) {
+    if (c === '\\') out += '\\\\';
+    else if (c === '"') out += '\\"';
+    else if (c === '\n') out += '\\n';
+    else out += c;
+  }
+  return out;
+}
+
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+  for (const [key, value] of Object.entries(fields)) {
+    assertValidKey(key);
+    if (value === true) {
+      parts.push(key);
+    } else if (needsQuoting(value)) {
+      parts.push(`${key}="${escapeQuoted(value)}"`);
+    } else {
+      parts.push(`${key}=${value}`);
+    }
+  }
+  return parts.join(' ');
+}
