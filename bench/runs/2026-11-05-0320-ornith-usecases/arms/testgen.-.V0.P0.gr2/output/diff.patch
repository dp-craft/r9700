diff --git a/tests/semver.test.ts b/tests/semver.test.ts
new file mode 100644
index 0000000..0e98fa0
--- /dev/null
+++ b/tests/semver.test.ts
@@ -0,0 +1,338 @@
+import { describe, expect, it } from "vitest";
+import {
+  SemVerError,
+  bump,
+  compare,
+  maxVersion,
+  parse,
+  satisfiesCaret,
+} from "../src/semver";
+
+describe("parse", () => {
+  it("parses a plain version with an empty prerelease list", () => {
+    expect(parse("1.2.3")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("parses zero components", () => {
+    expect(parse("0.0.0")).toEqual({ major: 0, minor: 0, patch: 0, pre: [] });
+  });
+
+  it("parses multi-digit components", () => {
+    expect(parse("10.20.30")).toEqual({
+      major: 10,
+      minor: 20,
+      patch: 30,
+      pre: [],
+    });
+  });
+
+  it("splits a single prerelease identifier", () => {
+    expect(parse("1.2.3-alpha")).toEqual({
+      major: 1,
+      minor: 2,
+      patch: 3,
+      pre: ["alpha"],
+    });
+  });
+
+  it("splits multiple prerelease identifiers", () => {
+    expect(parse("1.2.3-alpha.1.2")).toEqual({
+      major: 1,
+      minor: 2,
+      patch: 3,
+      pre: ["alpha", "1", "2"],
+    });
+  });
+
+  it("keeps numeric prerelease identifiers as strings", () => {
+    expect(parse("1.2.3-0.3.7")).toEqual({
+      major: 1,
+      minor: 2,
+      patch: 3,
+      pre: ["0", "3", "7"],
+    });
+  });
+
+  it("normalizes leading zeros in numeric components", () => {
+    const v = parse("01.02.03");
+    expect(v.major).toBe(1);
+    expect(v.minor).toBe(2);
+    expect(v.patch).toBe(3);
+    expect(v.pre).toEqual([]);
+  });
+
+  it("throws SemVerError for a version below three components", () => {
+    expect(() => parse("1.2")).toThrow(SemVerError);
+    expect(() => parse("1.2")).toThrow(/invalid version/);
+  });
+
+  it("throws for too many components", () => {
+    expect(() => parse("1.2.3.4")).toThrow(SemVerError);
+  });
+
+  it("throws when a non-numeric prefix is present", () => {
+    expect(() => parse("v1.2.3")).toThrow(SemVerError);
+  });
+
+  it("throws on trailing hyphen with no prerelease identifier", () => {
+    expect(() => parse("1.2.3-")).toThrow(SemVerError);
+  });
+
+  it("throws on build metadata (not supported)", () => {
+    expect(() => parse("1.2.3+build.5")).toThrow(SemVerError);
+  });
+
+  it("throws when the prerelease identifier contains an underscore", () => {
+    expect(() => parse("1.2.3-alpha_beta")).toThrow(SemVerError);
+  });
+
+  it("throws on a negative component", () => {
+    expect(() => parse("-1.2.3")).toThrow(SemVerError);
+  });
+
+  it("throws on empty input and surrounding whitespace", () => {
+    expect(() => parse("")).toThrow(SemVerError);
+    expect(() => parse(" 1.2.3")).toThrow(SemVerError);
+    expect(() => parse("1.2.3 ")).toThrow(SemVerError);
+  });
+
+  it("throws an Error (SemVerError is a subclass)", () => {
+    expect(new SemVerError("x")).toBeInstanceOf(Error);
+    expect(() => parse("nope")).toThrow();
+  });
+});
+
+describe("compare", () => {
+  it("returns 0 for equal versions", () => {
+    expect(compare("1.2.3", "1.2.3")).toBe(0);
+  });
+
+  it("orders by major", () => {
+    expect(compare("1.0.0", "2.0.0")).toBe(-1);
+    expect(compare("2.0.0", "1.0.0")).toBe(1);
+  });
+
+  it("major dominates minor and patch", () => {
+    expect(compare("1.9.9", "2.0.0")).toBe(-1);
+    expect(compare("2.0.0", "1.9.9")).toBe(1);
+  });
+
+  it("orders by minor when major is equal", () => {
+    expect(compare("1.1.0", "1.2.0")).toBe(-1);
+    expect(compare("1.2.0", "1.1.0")).toBe(1);
+  });
+
+  it("orders by patch when major and minor are equal", () => {
+    expect(compare("1.1.0", "1.1.5")).toBe(-1);
+    expect(compare("1.1.5", "1.1.0")).toBe(1);
+  });
+
+  it("treats a prerelease as lower than its release", () => {
+    expect(compare("1.0.0-alpha", "1.0.0")).toBe(-1);
+    expect(compare("1.0.0", "1.0.0-alpha")).toBe(1);
+  });
+
+  it("compares prerelease identifiers lexicographically", () => {
+    expect(compare("1.0.0-alpha", "1.0.0-beta")).toBe(-1);
+    expect(compare("1.0.0-beta", "1.0.0-alpha")).toBe(1);
+  });
+
+  it("numeric identifiers have lower precedence than alphanumeric ones", () => {
+    expect(compare("1.0.0-1", "1.0.0-alpha")).toBe(-1);
+    expect(compare("1.0.0-alpha", "1.0.0-1")).toBe(1);
+  });
+
+  it("compares numeric identifiers by value, not lexicographically", () => {
+    expect(compare("1.0.0-2", "1.0.0-10")).toBe(-1);
+    expect(compare("1.0.0-10", "1.0.0-2")).toBe(1);
+  });
+
+  it("a larger set of prerelease identifiers has higher precedence", () => {
+    expect(compare("1.0.0-alpha", "1.0.0-alpha.1")).toBe(-1);
+    expect(compare("1.0.0-alpha.1", "1.0.0-alpha")).toBe(1);
+  });
+
+  it("orders prerelease chains the way semver specifies", () => {
+    const order = [
+      "1.0.0-alpha",
+      "1.0.0-alpha.1",
+      "1.0.0-alpha.beta",
+      "1.0.0-beta",
+      "1.0.0-beta.2",
+      "1.0.0-beta.11",
+      "1.0.0-rc.1",
+      "1.0.0",
+    ];
+    for (let i = 0; i < order.length; i++) {
+      for (let j = i + 1; j < order.length; j++) {
+        expect(compare(order[i], order[j])).toBe(-1);
+        expect(compare(order[j], order[i])).toBe(1);
+      }
+    }
+  });
+
+  it("returns 0 for equal prerelease versions", () => {
+    expect(compare("1.0.0-alpha.1", "1.0.0-alpha.1")).toBe(0);
+  });
+
+  it("is antisymmetric across several pairs", () => {
+    const pairs = [
+      ["1.0.0", "2.0.0"],
+      ["1.2.3", "1.2.4"],
+      ["1.0.0-alpha", "1.0.0-beta"],
+      ["1.0.0-1", "1.0.0-2"],
+    ];
+    for (const [a, b] of pairs) {
+      expect(compare(a, b)).toBe(-compare(b, a));
+    }
+  });
+});
+
+describe("satisfiesCaret", () => {
+  describe("^X.Y.Z with X > 0", () => {
+    it("accepts the base version itself", () => {
+      expect(satisfiesCaret("1.2.3", "1.2.3")).toBe(true);
+    });
+
+    it("accepts higher versions in the same major", () => {
+      expect(satisfiesCaret("1.5.0", "1.2.3")).toBe(true);
+      expect(satisfiesCaret("1.2.9", "1.2.3")).toBe(true);
+    });
+
+    it("rejects versions below the base", () => {
+      expect(satisfiesCaret("1.2.2", "1.2.3")).toBe(false);
+      expect(satisfiesCaret("0.9.9", "1.2.3")).toBe(false);
+    });
+
+    it("rejects the next major", () => {
+      expect(satisfiesCaret("2.0.0", "1.2.3")).toBe(false);
+    });
+  });
+
+  describe("^0.Y.Z with Y > 0", () => {
+    it("accepts the base version and later patches of the same minor", () => {
+      expect(satisfiesCaret("0.2.3", "0.2.3")).toBe(true);
+      expect(satisfiesCaret("0.2.9", "0.2.3")).toBe(true);
+    });
+
+    it("rejects a lower patch or a different minor", () => {
+      expect(satisfiesCaret("0.2.2", "0.2.3")).toBe(false);
+      expect(satisfiesCaret("0.1.9", "0.2.3")).toBe(false);
+    });
+
+    it("rejects a bumped minor (the <0.3.0 boundary)", () => {
+      expect(satisfiesCaret("0.3.0", "0.2.3")).toBe(false);
+    });
+
+    it("rejects any non-zero major", () => {
+      expect(satisfiesCaret("1.0.0", "0.2.3")).toBe(false);
+    });
+  });
+
+  describe("^0.0.Z", () => {
+    it("accepts only the exact version", () => {
+      expect(satisfiesCaret("0.0.3", "0.0.3")).toBe(true);
+    });
+
+    it("rejects a higher patch", () => {
+      expect(satisfiesCaret("0.0.4", "0.0.3")).toBe(false);
+    });
+
+    it("rejects a different minor or major", () => {
+      expect(satisfiesCaret("0.1.0", "0.0.3")).toBe(false);
+      expect(satisfiesCaret("1.0.0", "0.0.3")).toBe(false);
+    });
+  });
+
+  describe("prerelease handling", () => {
+    it("a prerelease of the base sorts below the release and does not satisfy", () => {
+      expect(satisfiesCaret("1.2.3-alpha", "1.2.3")).toBe(false);
+    });
+
+    it("a prerelease with a different x.y.z is rejected outright", () => {
+      expect(satisfiesCaret("2.0.0-alpha", "1.2.3")).toBe(false);
+    });
+
+    it("a prerelease on a different patch than the base is rejected", () => {
+      expect(satisfiesCaret("1.2.4-beta", "1.2.3")).toBe(false);
+    });
+  });
+});
+
+describe("bump", () => {
+  it("bumps major and resets minor and patch", () => {
+    expect(bump("1.2.3", "major")).toBe("2.0.0");
+  });
+
+  it("bumps minor and resets patch", () => {
+    expect(bump("1.2.3", "minor")).toBe("1.3.0");
+  });
+
+  it("bumps patch", () => {
+    expect(bump("1.2.3", "patch")).toBe("1.2.4");
+  });
+
+  it("resets lower parts from zero", () => {
+    expect(bump("0.0.0", "patch")).toBe("0.0.1");
+    expect(bump("1.2.3", "major")).toBe("2.0.0");
+  });
+
+  it("carries the higher parts across a patch bump", () => {
+    expect(bump("9.9.9", "patch")).toBe("9.9.10");
+  });
+
+  it("rolls over major to two digits", () => {
+    expect(bump("9.9.9", "major")).toBe("10.0.0");
+  });
+
+  it("drops any prerelease when bumping", () => {
+    expect(bump("1.2.3-alpha", "patch")).toBe("1.2.4");
+    expect(bump("1.2.3-alpha.1", "minor")).toBe("1.3.0");
+    expect(bump("1.2.3-beta", "major")).toBe("2.0.0");
+  });
+});
+
+describe("maxVersion", () => {
+  it("returns null for an empty list", () => {
+    expect(maxVersion([])).toBeNull();
+  });
+
+  it("returns the single element for a one-item list", () => {
+    expect(maxVersion(["1.0.0"])).toBe("1.0.0");
+  });
+
+  it("finds the highest version regardless of input order", () => {
+    expect(maxVersion(["1.0.0", "2.0.0", "1.5.0"])).toBe("2.0.0");
+    expect(maxVersion(["2.0.0", "1.0.0"])).toBe("2.0.0");
+  });
+
+  it("compares numerically, not lexicographically", () => {
+    expect(maxVersion(["1.0.0", "1.9.0", "1.10.0"])).toBe("1.10.0");
+  });
+
+  it("prefers a release over its prerelease", () => {
+    expect(maxVersion(["1.0.0-alpha", "1.0.0"])).toBe("1.0.0");
+    expect(maxVersion(["1.0.0", "1.0.0-alpha"])).toBe("1.0.0");
+  });
+
+  it("returns the highest even among many prereleases", () => {
+    expect(
+      maxVersion(["1.0.0-alpha.1", "1.0.0", "1.0.0-alpha.2"]),
+    ).toBe("1.0.0");
+  });
+
+  it("handles duplicate versions", () => {
+    expect(maxVersion(["1.0.0", "1.0.0"])).toBe("1.0.0");
+  });
+
+  it("returns the single element without validating it (no comparison happens)", () => {
+    // The first/only element is assigned directly, so parse() is never reached.
+    expect(maxVersion(["1.2"])).toBe("1.2");
+  });
+
+  it("throws SemVerError when a compared version is invalid", () => {
+    // With two elements the second participates in compare(), which parses it.
+    expect(() => maxVersion(["1.0.0", "1.2"])).toThrow(SemVerError);
+    expect(() => maxVersion(["1.2", "1.0.0"])).toThrow(SemVerError);
+  });
+});
