+export class LogfmtError extends Error {
+  column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = "LogfmtError";
+    this.column = column;
+  }
+}
+
+const isSep = (c: string | undefined): boolean => c === " " || c === "\t";
+
+export function parse(line: string): Record<string, string | true> {
+  const result = new Map<string, string | true>();
+  let i = 0;
+  const n = line.length;
+
+  while (i < n) {
+    if (isSep(line[i])) {
+      i++;
+      continue;
+    }
+
+    const keyStart = i;
+    while (i < n && !isSep(line[i]) && line[i] !== "=") {
+      i++;
+    }
+    const key = line.slice(keyStart, i);
+
+    if (key.length === 0) {
+      throw new LogfmtError("empty key", i);
+    }
+
+    let value: string | true;
+
+    if (i >= n) {
+      value = true;
+    } else if (line[i] === "=") {
+      i++; // consume '='
+      if (i < n && line[i] === '"') {
+        const openCol = i;
+        i++; // consume opening quote
+        let sb = "";
+        while (true) {
+          if (i >= n) {
+            throw new LogfmtError("unterminated string", openCol);
+          }
+          const c = line[i];
+          if (c === '"') {
+            i++; // consume closing quote
+            break;
+          } else if (c === "\\") {
+            if (i + 1 >= n) {
+              throw new LogfmtError("unterminated string", openCol);
+            }
+            const e = line[i + 1];
+            if (e === '"') {
+              sb += '"';
+              i += 2;
+            } else if (e === "\\") {
+              sb += "\\";
+              i += 2;
+            } else if (e === "n") {
+              sb += "\n";
+              i += 2;
+            } else {
+              throw new LogfmtError("unknown escape", i);
+            }
+          } else {
+            sb += c;
+            i++;
+          }
+        }
+        if (i < n && !isSep(line[i])) {
+          throw new LogfmtError("unexpected char after quoted string", i);
+        }
+        value = sb;
+      } else {
+        const valStart = i;
+        while (i < n && !isSep(line[i])) {
+          i++;
+        }
+        value = line.slice(valStart, i);
+      }
+    } else {
+      value = true;
+    }
+
+    result.set(key, value);
+  }
+
+  return Object.fromEntries(result);
+}
+
+const keyForbidden = /[ \t="]/;
+const valueNeedsQuoting = /[ \t"\\=\n]/;
+
+function encodeValue(value: string): string {
+  return value
+    .replace(/\\/g, "\\\\")
+    .replace(/"/g, '\\"')
+    .replace(/\n/g, "\\n");
+}
+
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+
+  for (const key of Object.keys(fields)) {
+    if (key.length === 0 || keyForbidden.test(key)) {
+      throw new LogfmtError("invalid key", -1);
+    }
+
+    const value = fields[key] as string | true;
+    if (value === true) {
+      parts.push(key);
+    } else {
+      const v = (value.length === 0 || valueNeedsQuoting.test(value)) ? `"${encodeValue(value)}"` : value;
+      parts.push(key + "=" + v);
+    }
+  }
+
+  return parts.join(" ");
+}
