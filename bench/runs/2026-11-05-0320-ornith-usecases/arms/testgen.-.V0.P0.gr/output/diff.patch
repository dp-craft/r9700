diff --git a/tests/semver.test.ts b/tests/semver.test.ts
new file mode 100644
index 0000000..7b9c143
--- /dev/null
+++ b/tests/semver.test.ts
@@ -0,0 +1,203 @@
+import { describe, expect, it } from "vitest";
+
+import { SemVer, SemVerError, bump, compare, maxVersion, parse, satisfiesCaret } from "../src/semver";
+
+describe("parse", () => {
+  it("parses a full version with a multi-part prerelease", () => {
+    expect(parse("1.2.3-alpha.1")).toEqual({ major: 1, minor: 2, patch: 3, pre: ["alpha", "1"] });
+  });
+
+  it("defaults pre to an empty array when the prerelease tag is absent", () => {
+    expect(parse("1.2.3")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("keeps a single alphanumeric prerelease identifier as one string", () => {
+    expect(parse("0.0.1-rc4")).toEqual({ major: 0, minor: 0, patch: 1, pre: ["rc4"] });
+  });
+
+  it("parses large numeric parts into numbers (not strings)", () => {
+    const v = parse("10.20.30");
+    expect(v.major).toBe(10);
+    expect(v.minor).toBe(20);
+    expect(v.patch).toBe(30);
+  });
+
+  it("normalises leading zeros through Number() (the regex allows them)", () => {
+    expect(parse("01.02.03")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it.each(["", "1", "1.2", "1.2.3.", "1.2.3-", "1.2.3- ", "v1.2.3", "abc", "1.2.3-alpha_beta", "1.2.3.4", " 1.2.3", "1.2.3\t"])(
+    "throws SemVerError on invalid input %p",
+    (s) => {
+      expect(() => parse(s)).toThrow(SemVerError);
+      expect(() => parse(s)).toThrow(/invalid version/);
+    },
+  );
+
+  it("throws a plain Error as well (SemVerError extends Error)", () => {
+    expect(() => parse("nope")).toThrow(Error);
+  });
+});
+
+describe("SemVer", () => {
+  it("matches the shape produced by parse()", () => {
+    const v = parse("10.20.30-rc.4");
+    expect(v).toMatchObject({ major: 10, minor: 20, patch: 30, pre: ["rc", "4"] });
+    expect(Object.keys(v).sort()).toEqual(["major", "minor", "patch", "pre"]);
+  });
+
+  it("is thrown as both SemVerError and Error instances", () => {
+    try {
+      parse("bad");
+      throw new Error("parse did not throw");
+    } catch (e) {
+      expect(e).toBeInstanceOf(SemVerError);
+      expect(e).toBeInstanceOf(Error);
+    }
+  });
+});
+
+describe("compare", () => {
+  it.each([
+    ["1.0.0", "1.0.0"],
+    ["1.2.3", "1.2.3"],
+    ["01.0.0", "1.0.0"], // leading zeros normalise via Number()
+  ])("returns 0 for equal versions (%s / %s)", (a, b) => {
+    expect(compare(a, b)).toBe(0);
+  });
+
+  const lessThan: [string, string][] = [
+    ["1.0.0", "2.0.0"],
+    ["1.1.0", "1.2.0"],
+    ["1.0.1", "1.0.2"],
+    ["0.9.9", "1.0.0"],
+  ];
+
+  it.each(lessThan)("returns -1 when the first version is older (%s / %s)", (a, b) => {
+    expect(compare(a, b)).toBe(-1);
+  });
+
+  it.each(lessThan.map(([a, b]) => [b, a] as [string, string]))("returns 1 when the first version is newer (%s / %s)", (a, b) => {
+    expect(compare(a, b)).toBe(1);
+  });
+
+  it("puts a prerelease before its own release", () => {
+    expect(compare("1.0.0-alpha", "1.0.0")).toBe(-1);
+    expect(compare("1.0.0", "1.0.0-alpha")).toBe(1);
+  });
+
+  it.each([
+    ["1.0.0-alpha", "1.0.0-beta", -1],
+    ["1.0.0-alpha.1", "1.0.0-alpha.2", -1],
+    ["1.0.0-alpha", "1.0.0-alpha.1", -1], // shorter prerelease sorts before a longer one with the same prefix
+    ["1.0.0-1", "1.0.0-alpha", -1], // numeric identifiers have lower precedence than alphanumeric
+    ["1.0.0-alpha.1", "1.0.0-alpha.beta", -1],
+    ["1.0.0-alpha.beta", "1.0.0-alpha.gamma", -1],
+    ["1.0.0-gamma", "1.0.0-alpha", 1],
+  ])("%s is ordered before %s (%d)", (a, b, expected) => {
+    expect(compare(a, b)).toBe(expected);
+  });
+
+  it("gives higher-precedence to major.minor.patch than to the prerelease", () => {
+    expect(compare("1.0.0-alpha", "2.0.0-zeta")).toBe(-1);
+    expect(compare("2.0.0-alpha", "2.0.0")).toBe(-1);
+  });
+
+  it("is antisymmetric across a range of versions", () => {
+    const versions = [
+      "1.0.0",
+      "1.0.1",
+      "1.1.0",
+      "2.0.0",
+      "1.2.3-alpha",
+      "1.2.3-alpha.1",
+      "1.2.3-beta",
+      "0.0.1-rc.1",
+      "10.20.30",
+      "01.0.0",
+    ];
+    for (const a of versions) {
+      for (const b of versions) {
+        expect(compare(a, b)).toBe(-compare(b, a));
+      }
+    }
+  });
+});
+
+describe("satisfiesCaret", () => {
+  it("allows any version within the major range when base major > 0 (^1.2.3)", () => {
+    expect(satisfiesCaret("1.2.3", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.5.0", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.9.9", "1.2.3")).toBe(true);
+  });
+
+  it.each([
+    ["2.0.0"],
+    ["2.0.1"],
+    ["1.2.2"], // below base
+    ["0.9.9"], // below base
+    ["15.0.0"], // next major
+  ])("%s does not satisfy ^1.2.3", (v) => {
+    expect(satisfiesCaret(v, "1.2.3")).toBe(false);
+  });
+
+  it("pins to the minor range when base is ^0.y.z with y > 0 (^0.2.3)", () => {
+    expect(satisfiesCaret("0.2.3", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.2.9", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.3.0", "0.2.3")).toBe(false);
+  });
+
+  it("allows only the exact version when base is ^0.0.z (^0.0.3)", () => {
+    expect(satisfiesCaret("0.0.3", "0.0.3")).toBe(true);
+    expect(satisfiesCaret("0.0.4", "0.0.3")).toBe(false);
+  });
+
+  it("rejects a prerelease of a higher patch than the base", () => {
+    expect(satisfiesCaret("1.2.4-alpha", "1.2.3")).toBe(false);
+  });
+
+  it("rejects a prerelease of the exact base version (it sorts below the release)", () => {
+    expect(satisfiesCaret("1.2.3-rc.1", "1.2.3")).toBe(false);
+  });
+});
+
+describe("bump", () => {
+  it.each([
+    ["1.2.3", "major", "2.0.0"],
+    ["1.2.3", "minor", "1.3.0"],
+    ["1.2.3", "patch", "1.2.4"],
+    ["0.0.0", "patch", "0.0.1"],
+    ["9.9.9", "major", "10.0.0"],
+  ])("bumps %s by %s to get %s", (v, part, expected) => {
+    expect(bump(v, part)).toBe(expected);
+  });
+
+  it("resets lower parts and drops any prerelease on bump", () => {
+    expect(bump("1.2.3-alpha", "major")).toBe("2.0.0");
+    expect(bump("5.6.7-rc.1", "minor")).toBe("5.7.0");
+    expect(bump("1.2.3-rc.1", "patch")).toBe("1.2.4");
+  });
+});
+
+describe("maxVersion", () => {
+  it("returns null for an empty list", () => {
+    expect(maxVersion([])).toBeNull();
+  });
+
+  it.each([
+    [["1.0.0"], "1.0.0"],
+    [["1.2.3", "1.3.0", "1.2.9"], "1.3.0"],
+    [["2.0.0", "1.9.9", "3.0.0"], "3.0.0"],
+  ])("%s -> %s", (list, expected) => {
+    expect(maxVersion(list)).toBe(expected);
+  });
+
+  it("treats the release as greater than its own prereleases", () => {
+    expect(maxVersion(["1.0.0-alpha", "1.0.0", "1.0.0-beta"])).toBe("1.0.0");
+  });
+
+  it("returns one of the original strings from the input list", () => {
+    const list = ["0.0.1", "2.0.0", "1.5.0"];
+    expect(list).toContain(maxVersion(list));
+  });
+});
