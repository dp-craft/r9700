+/**
+ * logfmt parsing and formatting.
+ *
+ * See SPEC.md for the full contract. In short: a line is a sequence of
+ * `key` / `key=value` / `key="quoted value"` pairs separated by one or more
+ * spaces or tabs.
+ */
+
+const SEP = (c: string): boolean => c === ' ' || c === '\t';
+
+export class LogfmtError extends Error {
+  column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = "LogfmtError";
+    this.column = column;
+  }
+}
+
+/**
+ * Parse a single logfmt line into an object. Insertion order is preserved and
+ * a repeated key keeps its first-seen position with the last value winning.
+ */
+export function parse(line: string): Record<string, string | true> {
+  const result: Record<string, string | true> = {};
+  const n = line.length;
+  let i = 0;
+
+  while (i < n) {
+    // Skip the separator(s) before each pair.
+    while (i < n && SEP(line[i]!)) i++;
+    if (i >= n) break;
+
+    // Read the key: everything until '=', a separator, or end of line.
+    const keyStart = i;
+    while (i < n && line[i]! !== '=' && !SEP(line[i]!)) i++;
+    const key = line.slice(keyStart, i);
+
+    // No '=' following the key -> bare key with value `true`.
+    if (i >= n || SEP(line[i]!)) {
+      result[key] = true;
+      continue;
+    }
+
+    // Current character is '='.
+    if (key.length === 0) {
+      throw new LogfmtError("empty key", i);
+    }
+
+    i++; // consume '='
+    if (i >= n) {
+      result[key] = "";
+      continue;
+    }
+
+    if (line[i]! === '"') {
+      const quoteStart = i;
+      let value = "";
+      i++; // consume opening quote
+      while (true) {
+        if (i >= n) {
+          throw new LogfmtError("unterminated quote", quoteStart);
+        }
+        const c = line[i]!;
+        if (c === '"') {
+          i++; // consume closing quote
+          break;
+        }
+        if (c === '\\') {
+          if (i + 1 >= n) {
+            throw new LogfmtError("unterminated quote", quoteStart);
+          }
+          const next = line[i + 1]!;
+          if (next === '"') {
+            value += '"';
+            i += 2;
+            continue;
+          }
+          if (next === '\\') {
+            value += '\\';
+            i += 2;
+            continue;
+          }
+          if (next === 'n') {
+            value += '\n';
+            i += 2;
+            continue;
+          }
+          throw new LogfmtError("unknown escape", i);
+        }
+        value += c;
+        i++;
+      }
+
+      // After the closing quote only separators or end of line are allowed.
+      if (i < n && !SEP(line[i]!)) {
+        throw new LogfmtError("unexpected character after quote", i);
+      }
+      result[key] = value;
+      continue;
+    }
+
+    // Bare value: runs until the next separator or end of line. May contain '='.
+    const valueStart = i;
+    while (i < n && !SEP(line[i]!)) i++;
+    result[key] = line.slice(valueStart, i);
+  }
+
+  return result;
+}
+
+/** Determine whether a bare field needs to be quoted when formatted. */
+const needsQuote = (value: string): boolean =>
+  value.length === 0 ||
+  value.includes(' ') ||
+  value.includes('\t') ||
+  value.includes('"') ||
+  value.includes('\\') ||
+  value.includes('=') ||
+  value.includes('\n');
+
+function formatValue(value: string): string {
+  if (!needsQuote(value)) return value;
+  let out = '"';
+  for (const ch of value) {
+    if (ch === '"') out += '\\"';
+    else if (ch === '\\') out += '\\\\';
+    else if (ch === '\n') out += '\\n';
+    else out += ch;
+  }
+  return out + '"';
+}
+
+/**
+ * Format an object back into a logfmt line. Pairs are joined with a single
+ * space in insertion order. Throws LogfmtError (column -1) for invalid keys.
+ */
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+  for (const key of Object.keys(fields)) {
+    if (
+      key.length === 0 ||
+      key.includes(' ') ||
+      key.includes('\t') ||
+      key.includes('=') ||
+      key.includes('"')
+    ) {
+      throw new LogfmtError("invalid key", -1);
+    }
+    // `key` comes from Object.keys, so the entry is always present.
+    const value = fields[key]!;
+    parts.push(value === true ? key : formatValue(value));
+  }
+  return parts.join(' ');
+}
