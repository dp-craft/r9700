diff --git a/tests/semver.test.ts b/tests/semver.test.ts
new file mode 100644
index 0000000..bdaeb5d
--- /dev/null
+++ b/tests/semver.test.ts
@@ -0,0 +1,182 @@
+import { describe, expect, it } from "vitest";
+import { SemVer, SemVerError, bump, compare, maxVersion, parse, satisfiesCaret } from "../src/semver";
+
+describe("parse", () => {
+  it("parses a plain version with an empty prerelease", () => {
+    expect(parse("1.2.3")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("splits a prerelease into identifiers", () => {
+    expect(parse("1.2.3-alpha.1")).toEqual({ major: 1, minor: 2, patch: 3, pre: ["alpha", "1"] });
+  });
+
+  it("parses zero-padded numeric components as numbers", () => {
+    expect(parse("01.02.03")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("preserves non-numeric prerelease identifiers", () => {
+    expect(parse("0.0.0-dev.4+build.7")).toEqual({
+      major: 0,
+      minor: 0,
+      patch: 0,
+      pre: ["dev", "4", "build", "7"],
+    });
+  });
+
+  it("returns the SemVer interface", () => {
+    const v = parse("1.2.3");
+    expect(v).toMatchTypeOf<SemVer>();
+  });
+});
+
+describe("parse invalid input", () => {
+  it.each([
+    "1",
+    "1.2",
+    "1.2.3.4",
+    "1.2.x",
+    "v1.2.3",
+    "1.2.3-",
+    "1.2.3-alpha_1",
+    "-1.2.3",
+    "abc.def.ghi",
+    "",
+    " 1.2.3 ",
+    "1.2.3-",
+  ])("throws SemVerError for %s", (bad) => {
+    expect(() => parse(bad)).toThrow(SemVerError);
+    expect(() => parse(bad)).toThrow(/invalid version/);
+  });
+
+  it("the thrown error is an instanceof Error", () => {
+    expect(() => parse("nope")).toThrow(Error);
+  });
+});
+
+describe("compare - core major/minor/patch ordering", () => {
+  it("returns 0 for identical versions", () => {
+    expect(compare("1.2.3", "1.2.3")).toBe(0);
+  });
+
+  it("compares by major, then minor, then patch", () => {
+    expect(compare("1.0.0", "2.0.0")).toBe(-1);
+    expect(compare("2.0.0", "1.0.0")).toBe(1);
+    expect(compare("1.1.0", "1.0.9")).toBe(1);
+    expect(compare("1.0.2", "1.0.1")).toBe(1);
+    expect(compare("1.0.1", "1.0.2")).toBe(-1);
+  });
+
+  it("does lexicographic-independent numeric comparison (not string)", () => {
+    expect(compare("10.0.0", "9.9.9")).toBe(1);
+    expect(compare("1.10.0", "1.9.0")).toBe(1);
+  });
+});
+
+describe("compare - prerelease precedence", () => {
+  it("a prerelease sorts before its release", () => {
+    expect(compare("1.0.0-alpha", "1.0.0")).toBe(-1);
+    expect(compare("1.0.0", "1.0.0-alpha")).toBe(1);
+  });
+
+  it("compares numeric prerelease identifiers numerically", () => {
+    expect(compare("1.0.0-1", "1.0.0-2")).toBe(-1);
+    expect(compare("1.0.0-2", "1.0.0-10")).toBe(-1);
+    expect(compare("1.0.0-10", "1.0.0-9")).toBe(1);
+  });
+
+  it("a numeric identifier has lower precedence than an alphanumeric one", () => {
+    expect(compare("1.0.0-1", "1.0.0-alpha")).toBe(-1);
+    expect(compare("1.0.0-alpha", "1.0.0-1")).toBe(1);
+  });
+
+  it("compares field by field, then longer wins on a shared prefix", () => {
+    expect(compare("1.0.0-alpha", "1.0.0-beta")).toBe(-1);
+    expect(compare("1.0.0-alpha.1", "1.0.0-alpha.2")).toBe(-1);
+    expect(compare("1.0.0-alpha", "1.0.0-alpha.1")).toBe(-1);
+  });
+
+  it("returns 0 for equal prereleases", () => {
+    expect(compare("1.0.0-alpha.1", "1.0.0-alpha.1")).toBe(0);
+  });
+
+  it("ignores build metadata (regex does not capture it)", () => {
+    // Build metadata is not part of this implementation's grammar, so a bare
+    // '+' version is invalid and must throw rather than be treated as equal.
+    expect(() => parse("1.0.0+build")).toThrow(SemVerError);
+  });
+});
+
+describe("satisfiesCaret - caret ranges", () => {
+  it("^major allows the same major with a higher or equal minor/patch", () => {
+    expect(satisfiesCaret("1.2.3", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.9.9", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.0.0", "1.2.3")).toBe(false); // lower than base
+    expect(satisfiesCaret("2.0.0", "1.2.3")).toBe(false);
+  });
+
+  it("^0.minor only bumps the patch within the same minor", () => {
+    expect(satisfiesCaret("0.2.3", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.2.9", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.3.0", "0.2.3")).toBe(false);
+    expect(satisfiesCaret("1.0.0", "0.2.3")).toBe(false);
+  });
+
+  it("^0.0.patch allows only the exact version", () => {
+    expect(satisfiesCaret("0.0.3", "0.0.3")).toBe(true);
+    expect(satisfiesCaret("0.0.4", "0.0.3")).toBe(false);
+    expect(satisfiesCaret("0.1.0", "0.0.3")).toBe(false);
+  });
+
+  it("rejects prereleases that are lower than the base even when x.y.z matches", () => {
+    expect(satisfiesCaret("1.2.3-alpha", "1.2.3")).toBe(false);
+  });
+
+  it("allows a release matching the base x.y.z of a prerelease base", () => {
+    // base is a prerelease: ^1.2.3-alpha -> major>0, and 1.2.3 >= 1.2.3-alpha
+    expect(satisfiesCaret("1.2.3", "1.2.3-alpha")).toBe(true);
+    expect(satisfiesCaret("1.5.0", "1.2.3-alpha")).toBe(true);
+    expect(satisfiesCaret("2.0.0", "1.2.3-alpha")).toBe(false);
+  });
+});
+
+describe("bump", () => {
+  it("bumps major and resets lower parts", () => {
+    expect(bump("1.2.3", "major")).toBe("2.0.0");
+  });
+
+  it("bumps minor and resets patch", () => {
+    expect(bump("1.2.3", "minor")).toBe("1.3.0");
+  });
+
+  it("bumps patch", () => {
+    expect(bump("1.2.3", "patch")).toBe("1.2.4");
+  });
+
+  it("resets lower parts and drops prerelease on bump", () => {
+    expect(bump("1.2.3-alpha.1", "major")).toBe("2.0.0");
+    expect(bump("0.0.9-rc.5", "minor")).toBe("0.1.0");
+  });
+
+  it("throws for an invalid version", () => {
+    expect(() => bump("garbage", "patch")).toThrow(SemVerError);
+  });
+});
+
+describe("maxVersion", () => {
+  it("returns null for an empty list", () => {
+    expect(maxVersion([])).toBeNull();
+  });
+
+  it("returns the highest version using numeric comparison", () => {
+    expect(maxVersion(["1.0.0", "2.0.0", "1.5.0"])).toBe("2.0.0");
+    expect(maxVersion(["9.0.0", "10.0.0", "2.0.0"])).toBe("10.0.0");
+  });
+
+  it("treats a release as higher than a prerelease of the same x.y.z", () => {
+    expect(maxVersion(["1.0.0-alpha", "1.0.0"])).toBe("1.0.0");
+  });
+
+  it("returns the single element unchanged", () => {
+    expect(maxVersion(["3.1.4"])).toBe("3.1.4");
+  });
+});
