+export class LogfmtError extends Error {
+  column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.column = column;
+    Object.setPrototypeOf(this, LogfmtError.prototype);
+  }
+}
+
+function parseQuoted(
+  line: string,
+  start: number,
+): { s: string; end: number } {
+  // line[start] === '"'
+  let s = "";
+  let i = start + 1;
+  const n = line.length;
+  while (i < n) {
+    const c = line[i];
+    if (c === "\\") {
+      const esc = i + 1;
+      if (esc >= n) throw new LogfmtError(`bad escape`, i);
+      const d = line[esc];
+      if (d === '"') { s += '"'; i += 2; continue; }
+      if (d === "\\") { s += "\\"; i += 2; continue; }
+      if (d === "n") { s += "\n"; i += 2; continue; }
+      throw new LogfmtError(`unknown escape`, i);
+    }
+    if (c === '"') return { s, end: i + 1 };
+    s += c;
+    i++;
+  }
+  throw new LogfmtError(`unterminated string`, start);
+}
+
+function formatKey(key: string): string {
+  if (key.length === 0 || /[ \t="]/.test(key)) {
+    throw new LogfmtError(`invalid key`, -1);
+  }
+  return key;
+}
+
+function formatValue(value: string): string {
+  if (value.length === 0 || /[ \t"\\=\n]/.test(value)) {
+    const enc = value
+      .replace(/\\/g, "\\\\")
+      .replace(/"/g, '\\"')
+      .replace(/\n/g, "\\n");
+    return `"${enc}"`;
+  }
+  return value;
+}
+
+export function parse(line: string): Record<string, string | true> {
+  const result: Record<string, string | true> = {};
+  const n = line.length;
+  let i = 0;
+
+  while (i < n) {
+    while (i < n && (line[i] === " " || line[i] === "\t")) i++;
+    if (i >= n) break;
+
+    const keyStart = i;
+    while (
+      i < n &&
+      line[i] !== "=" &&
+      line[i] !== " " &&
+      line[i] !== "\t"
+    ) i++;
+    const key = line.slice(keyStart, i);
+
+    if (key.length === 0) {
+      throw new LogfmtError(`empty key`, i);
+    }
+
+    let val: string | true;
+    if (i >= n || line[i] === " " || line[i] === "\t") {
+      val = true;
+    } else {
+      i++; // consume '='
+      if (i >= n) {
+        val = "";
+      } else if (line[i] === '"') {
+        const { s, end } = parseQuoted(line, i);
+        i = end;
+        if (i < n && line[i] !== " " && line[i] !== "\t") {
+          throw new LogfmtError(`unexpected character after quote`, i);
+        }
+        val = s;
+      } else {
+        const vStart = i;
+        while (i < n && line[i] !== " " && line[i] !== "\t") i++;
+        val = line.slice(vStart, i);
+      }
+    }
+
+    result[key] = val;
+  }
+
+  return result;
+}
+
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+  for (const [key, value] of Object.entries(fields)) {
+    const k = formatKey(key);
+    if (value === true) {
+      parts.push(k);
+    } else {
+      parts.push(`${k}=${formatValue(value)}`);
+    }
+  }
+  return parts.join(" ");
+}
