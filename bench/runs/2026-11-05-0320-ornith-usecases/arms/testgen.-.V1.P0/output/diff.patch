diff --git a/tests/semver.test.ts b/tests/semver.test.ts
new file mode 100644
index 0000000..dd17e5d
--- /dev/null
+++ b/tests/semver.test.ts
@@ -0,0 +1,235 @@
+import { describe, expect, it } from "vitest";
+
+import { SemVerError, bump, compare, maxVersion, parse, satisfiesCaret } from "../src/semver";
+
+describe("SemVerError", () => {
+  it("extends Error", () => {
+    expect(new SemVerError("bad version")).toBeInstanceOf(Error);
+  });
+});
+
+describe("parse", () => {
+  it("parses a plain version with an empty prerelease list", () => {
+    expect(parse("1.2.3")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("parses zero components", () => {
+    expect(parse("0.0.0")).toEqual({ major: 0, minor: 0, patch: 0, pre: [] });
+  });
+
+  it("parses multi-digit components as base-10 numbers", () => {
+    expect(parse("10.20.30")).toEqual({ major: 10, minor: 20, patch: 30, pre: [] });
+  });
+
+  it("normalizes leading-zero components through Number()", () => {
+    expect(parse("01.02.03")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("parses a single-part prerelease", () => {
+    expect(parse("1.2.3-alpha")).toEqual({ major: 1, minor: 2, patch: 3, pre: ["alpha"] });
+  });
+
+  it("splits a multi-part prerelease on dots", () => {
+    expect(parse("1.2.3-alpha.beta.2")).toEqual({
+      major: 1,
+      minor: 2,
+      patch: 3,
+      pre: ["alpha", "beta", "2"],
+    });
+  });
+
+  it("keeps digits and letters together across parts", () => {
+    expect(parse("1.2.3-1.alpha.2")).toEqual({
+      major: 1,
+      minor: 2,
+      patch: 3,
+      pre: ["1", "alpha", "2"],
+    });
+  });
+
+  it("throws SemVerError for a version missing components", () => {
+    expect(() => parse("")).toThrow(SemVerError);
+    expect(() => parse("1")).toThrow(SemVerError);
+    expect(() => parse("1.2")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError for too many components", () => {
+    expect(() => parse("1.2.3.4")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError for a non-numeric version", () => {
+    expect(() => parse("v1.2.3")).toThrow(SemVerError);
+    expect(() => parse("abc.def.ghi")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError for negative components", () => {
+    expect(() => parse("-1.2.3")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError for a prerelease with no characters", () => {
+    expect(() => parse("1.2.3-")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError for illegal prerelease characters", () => {
+    expect(() => parse("1.2.3-alpha_beta")).toThrow(SemVerError);
+    expect(() => parse("1.2.3+build")).toThrow(SemVerError);
+  });
+
+  it("throws SemVerError on surrounding whitespace", () => {
+    expect(() => parse(" 1.2.3")).toThrow(SemVerError);
+    expect(() => parse("1.2.3 ")).toThrow(SemVerError);
+  });
+});
+
+describe("compare", () => {
+  it("returns 0 for identical versions", () => {
+    expect(compare("1.2.3", "1.2.3")).toBe(0);
+  });
+
+  it("orders by major", () => {
+    expect(compare("1.2.3", "2.0.0")).toBe(-1);
+    expect(compare("2.0.0", "1.2.3")).toBe(1);
+  });
+
+  it("orders by minor", () => {
+    expect(compare("1.2.3", "1.3.0")).toBe(-1);
+    expect(compare("1.3.0", "1.2.3")).toBe(1);
+  });
+
+  it("orders by patch", () => {
+    expect(compare("1.2.3", "1.2.4")).toBe(-1);
+    expect(compare("1.2.4", "1.2.3")).toBe(1);
+  });
+
+  it("compares components numerically rather than lexically", () => {
+    expect(compare("1.9.9", "1.10.0")).toBe(-1);
+    expect(compare("1.10.0", "1.9.9")).toBe(1);
+  });
+
+  it("sorts a prerelease before its release with the same x.y.z", () => {
+    expect(compare("1.2.3-alpha", "1.2.3")).toBe(-1);
+    expect(compare("1.2.3", "1.2.3-alpha")).toBe(1);
+  });
+
+  it("compares prerelease identifiers as strings", () => {
+    expect(compare("1.2.3-alpha", "1.2.3-beta")).toBe(-1);
+    expect(compare("1.2.3-beta", "1.2.3-alpha")).toBe(1);
+  });
+
+  it("sorts a numeric identifier before an alphanumeric one", () => {
+    expect(compare("1.2.3-1", "1.2.3-alpha")).toBe(-1);
+    expect(compare("1.2.3-alpha", "1.2.3-1")).toBe(1);
+  });
+
+  it("compares numeric identifiers numerically", () => {
+    expect(compare("1.2.3-99", "1.2.3-100")).toBe(-1);
+    expect(compare("1.2.3-100", "1.2.3-99")).toBe(1);
+  });
+
+  it("compares each identifier in a multi-part prerelease", () => {
+    expect(compare("1.2.3-alpha.1", "1.2.3-alpha.2")).toBe(-1);
+    expect(compare("1.2.3-alpha.2", "1.2.3-alpha.1")).toBe(1);
+  });
+
+  it("treats a shorter prerelease as lower when the prefixes match", () => {
+    expect(compare("1.2.3-alpha", "1.2.3-alpha.1")).toBe(-1);
+    expect(compare("1.2.3-alpha.1", "1.2.3-alpha")).toBe(1);
+  });
+
+  it("treats equal numeric identifiers as equal despite leading zeros", () => {
+    expect(compare("1.2.3-alpha.1", "1.2.3-alpha.01")).toBe(0);
+  });
+
+  it("ignores prereleases when the base version already differs", () => {
+    expect(compare("1.2.4-alpha", "1.2.3-zeta")).toBe(1);
+    expect(compare("1.2.3-zeta", "1.2.4-alpha")).toBe(-1);
+  });
+});
+
+describe("satisfiesCaret", () => {
+  it("^X.Y.Z accepts anything >= base within the same major", () => {
+    expect(satisfiesCaret("1.2.3", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.5.0", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.99.99", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("2.0.0", "1.2.3")).toBe(false);
+  });
+
+  it("^X.Y.Z rejects a version below the base", () => {
+    expect(satisfiesCaret("1.0.0", "1.2.3")).toBe(false);
+  });
+
+  it("^0.Y.Z requires major 0 and matching minor", () => {
+    expect(satisfiesCaret("0.2.3", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.2.9", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.2.2", "0.2.3")).toBe(false);
+    expect(satisfiesCaret("0.3.0", "0.2.3")).toBe(false);
+    expect(satisfiesCaret("1.2.3", "0.2.3")).toBe(false);
+  });
+
+  it("^0.0.Z requires exactly 0.0.Z", () => {
+    expect(satisfiesCaret("0.0.3", "0.0.3")).toBe(true);
+    expect(satisfiesCaret("0.0.4", "0.0.3")).toBe(false);
+    expect(satisfiesCaret("0.0.2", "0.0.3")).toBe(false);
+    expect(satisfiesCaret("0.1.0", "0.0.3")).toBe(false);
+  });
+
+  it("rejects a prerelease that shares the base x.y.z (it is below the release)", () => {
+    expect(satisfiesCaret("1.2.3-alpha", "1.2.3")).toBe(false);
+  });
+
+  it("rejects a prerelease whose x.y.z differs from the base", () => {
+    expect(satisfiesCaret("1.2.4-alpha", "1.2.3")).toBe(false);
+  });
+});
+
+describe("bump", () => {
+  it("bumps major and resets minor and patch to 0", () => {
+    expect(bump("1.2.3", "major")).toBe("2.0.0");
+    expect(bump("5.6.7", "major")).toBe("6.0.0");
+  });
+
+  it("bumps minor and resets patch to 0", () => {
+    expect(bump("1.2.3", "minor")).toBe("1.3.0");
+    expect(bump("5.6.7", "minor")).toBe("5.7.0");
+  });
+
+  it("bumps patch, concatenating multi-digit results", () => {
+    expect(bump("1.2.3", "patch")).toBe("1.2.4");
+    expect(bump("9.9.9", "patch")).toBe("9.9.10");
+  });
+
+  it("drops any prerelease", () => {
+    expect(bump("1.2.3-alpha", "major")).toBe("2.0.0");
+    expect(bump("1.2.3-beta.1", "minor")).toBe("1.3.0");
+    expect(bump("1.2.3-rc.2", "patch")).toBe("1.2.4");
+  });
+});
+
+describe("maxVersion", () => {
+  it("returns null for an empty list", () => {
+    expect(maxVersion([])).toBeNull();
+  });
+
+  it("returns the single element", () => {
+    expect(maxVersion(["1.2.3"])).toBe("1.2.3");
+  });
+
+  it("returns the highest version regardless of input order", () => {
+    expect(maxVersion(["1.0.0", "3.0.0", "2.0.0"])).toBe("3.0.0");
+    expect(maxVersion(["3.0.0", "2.0.0", "1.0.0"])).toBe("3.0.0");
+  });
+
+  it("beats a prerelease with its release at the same x.y.z", () => {
+    expect(maxVersion(["1.2.3", "1.2.3-alpha"])).toBe("1.2.3");
+    expect(maxVersion(["1.2.3-alpha", "1.2.3"])).toBe("1.2.3");
+  });
+
+  it("compares numerically rather than lexically", () => {
+    expect(maxVersion(["1.9.9", "1.10.0"])).toBe("1.10.0");
+    expect(maxVersion(["1.10.0", "1.9.9"])).toBe("1.10.0");
+  });
+
+  it("returns the element when all entries are equal", () => {
+    expect(maxVersion(["1.2.3", "1.2.3"])).toBe("1.2.3");
+  });
+});
