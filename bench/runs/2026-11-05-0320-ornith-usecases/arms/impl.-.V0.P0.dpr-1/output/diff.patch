+/**
+ * logfmt parsing and formatting.
+ *
+ * See SPEC.md for the authoritative description of the grammar and error rules.
+ */
+
+export class LogfmtError extends Error {
+  column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = "LogfmtError";
+    this.column = column;
+  }
+}
+
+function fail(column: number, message: string): never {
+  throw new LogfmtError(message, column);
+}
+
+// ---------------------------------------------------------------------------
+// parse
+// ---------------------------------------------------------------------------
+
+export function parse(line: string): Record<string, string | true> {
+  const result = new Map<string, string | true>();
+  const n = line.length;
+  let i = 0;
+
+  while (i < n) {
+    // Skip one or more separators (spaces/tabs) between pairs. Leading
+    // whitespace on the line is skipped here as well, giving {} for an
+    // empty/whitespace-only line.
+    while (i < n && (line[i] === " " || line[i] === "\t")) {
+      i++;
+    }
+    if (i >= n) break;
+
+    const pairStart = i;
+
+    // Read the key: any run of characters that is not '=', space or tab.
+    let keyEnd = i;
+    while (keyEnd < n && line[keyEnd] !== "=" && line[keyEnd] !== " " && line[keyEnd] !== "\t") {
+      keyEnd++;
+    }
+
+    // The only way to read zero key characters is when the pair begins with '='.
+    if (keyEnd === pairStart) {
+      fail(i, "empty key");
+    }
+
+    const key = line.slice(pairStart, keyEnd);
+
+    const next = keyEnd < n ? line[keyEnd] : undefined;
+
+    if (next === undefined || next === " " || next === "\t") {
+      // No '=' -> bare flag.
+      result.set(key, true);
+      i = keyEnd;
+      continue;
+    }
+
+    // next === '=': parse a value.
+    const valueStart = keyEnd + 1;
+
+    if (valueStart >= n) {
+      // 'key=' with nothing following -> empty string.
+      result.set(key, "");
+      i = valueStart;
+      continue;
+    }
+
+    const first = line[valueStart];
+
+    if (first === '"') {
+      let out = "";
+      let j = valueStart + 1;
+      let closed = false;
+
+      while (j < n) {
+        const c = line[j]!;
+        if (c === "\\") {
+          if (j + 1 >= n) break; // quote will never close
+          const esc = line[j + 1]!;
+          if (esc === '"') {
+            out += '"';
+            j += 2;
+            continue;
+          }
+          if (esc === "\\") {
+            out += "\\";
+            j += 2;
+            continue;
+          }
+          if (esc === "n") {
+            out += "\n";
+            j += 2;
+            continue;
+          }
+          fail(j, `unknown escape: \\${esc}`);
+        } else if (c === '"') {
+          j++; // consume closing quote
+          closed = true;
+          break;
+        } else {
+          out += c;
+          j++;
+        }
+      }
+
+      if (!closed) {
+        fail(valueStart, "unterminated quoted value");
+      }
+
+      // After a closing quote the next character must be a separator or EOF.
+      if (j < n && line[j] !== " " && line[j] !== "\t") {
+        fail(j, "unexpected character after quoted value");
+      }
+
+      result.set(key, out);
+      i = j;
+      continue;
+    }
+
+    // Bare value: runs until the next space or tab (may contain '=').
+    let k = valueStart;
+    while (k < n && line[k] !== " " && line[k] !== "\t") {
+      k++;
+    }
+    result.set(key, line.slice(valueStart, k));
+    i = k;
+  }
+
+  const out: Record<string, string | true> = {};
+  for (const [key, value] of result) {
+    out[key] = value;
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------------------
+// format
+// ---------------------------------------------------------------------------
+
+function valueNeedsQuoting(value: string): boolean {
+  if (value === "") return true;
+  for (let i = 0; i < value.length; i++) {
+    const c = value[i];
+    if (c === " " || c === "\t" || c === '"' || c === "\\" || c === "=" || c === "\n") {
+      return true;
+    }
+  }
+  return false;
+}
+
+function quoteValue(value: string): string {
+  let out = '"';
+  for (let i = 0; i < value.length; i++) {
+    const c = value[i]!;
+    if (c === '"') out += '\\"';
+    else if (c === "\\") out += "\\\\";
+    else if (c === "\n") out += "\\n";
+    else out += c;
+  }
+  return out + '"';
+}
+
+function keyIsValid(key: string): boolean {
+  if (key === "") return false;
+  for (let i = 0; i < key.length; i++) {
+    const c = key[i];
+    if (c === " " || c === "\t" || c === "=" || c === '"') return false;
+  }
+  return true;
+}
+
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+
+  for (const [key, value] of Object.entries(fields)) {
+    if (!keyIsValid(key)) {
+      fail(-1, `invalid key: ${JSON.stringify(key)}`);
+    }
+
+    let token: string;
+    if (value === true) {
+      token = key;
+    } else if (valueNeedsQuoting(value)) {
+      token = key + quoteValue(value);
+    } else {
+      token = key + "=" + value;
+    }
+
+    parts.push(token);
+  }
+
+  return parts.join(" ");
+}
