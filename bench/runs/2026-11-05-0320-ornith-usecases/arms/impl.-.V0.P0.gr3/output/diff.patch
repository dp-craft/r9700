+/**
+ * logfmt parsing and formatting.
+ *
+ * @see SPEC.md
+ */
+
+/** Error thrown for invalid input, tagged with a 0-based offending column. */
+export class LogfmtError extends Error {
+  readonly column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = "LogfmtError";
+    this.column = column;
+  }
+}
+
+const isSep = (c: string | undefined): boolean => c === " " || c === "\t";
+
+/**
+ * Parse a single logfmt line into an ordered map of key -> value.
+ *
+ * - `key`        -> true
+ * - `key=`       -> ""
+ * - `key=value`  -> bare value up to the next space/tab (may contain `=`)
+ * - `key="..."`  -> quoted value with `\"`, `\\`, `\n` escapes decoded
+ */
+export function parse(line: string): Record<string, string | true> {
+  const n = line.length;
+  let i = 0;
+  const result: Record<string, string | true> = {};
+
+  while (i < n) {
+    // Skip separators between pairs.
+    while (i < n && isSep(line[i])) i++;
+    if (i >= n) break;
+
+    // Read the key: runs until `=`, space or tab.
+    const keyStart = i;
+    while (i < n && line[i] !== "=" && !isSep(line[i])) i++;
+    const key = line.slice(keyStart, i);
+    if (key.length === 0) {
+      // Only reachable when the pair starts with `=`.
+      throw new LogfmtError("empty key", i);
+    }
+
+    let value: string | true;
+    if (i < n && line[i] === "=") {
+      i++; // consume '='
+      if (i < n && line[i] === '"') {
+        value = parseQuoted();
+      } else {
+        const vStart = i;
+        while (i < n && !isSep(line[i])) i++;
+        value = line.slice(vStart, i);
+      }
+    } else {
+      value = true;
+    }
+
+    // Last duplicate key wins; first-seen order is preserved.
+    result[key] = value;
+  }
+
+  return result;
+
+  function parseQuoted(): string {
+    const open = i; // position of the opening quote
+    const out: string[] = [];
+    while (i < n) {
+      const c = line[i]!; // guaranteed defined by the while guard
+      if (c === "\\") {
+        if (i + 1 >= n) break; // trailing backslash -> unterminated below
+        const next = line.charAt(i + 1);
+        if (next === '"' || next === "\\" || next === "n") {
+          out.push(next);
+          i += 2;
+          continue;
+        }
+        throw new LogfmtError(`unknown escape \\${next}`, i); // column = backslash
+      }
+      if (c == '"') {
+        i++; // consume closing quote
+        if (i < n && !isSep(line[i])) {
+          throw new LogfmtError("non-whitespace after quote", i);
+        }
+        return out.join("");
+      }
+      out.push(c);
+      i++;
+    }
+    throw new LogfmtError("unterminated quote", open);
+  }
+}
+
+/** Quote+escape a value for output, per the round-trip rule in SPEC.md. */
+function formatValue(value: string): string {
+  if (value.length === 0 || /[ \t"\\=\n]/.test(value)) {
+    const escaped = value
+      .replace(/\\/g, "\\\\") // backslash first so escapes are not doubled
+      .replace(/"/g, '\\"')
+      .replace(/\n/g, "\\n");
+    return '"' + escaped + '"';
+  }
+  return value;
+}
+
+/**
+ * Render fields as a logfmt line, in insertion order.
+ * Throws for keys that are empty or contain space, tab, `=` or `"`.
+ */
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+  for (const [key, value] of Object.entries(fields)) {
+    if (key.length === 0 || /[ \t="]/.test(key)) {
+      throw new LogfmtError("invalid key", -1);
+    }
+    const rendered = value === true ? key : key + "=" + formatValue(value);
+    parts.push(rendered);
+  }
+  return parts.join(" ");
+}
