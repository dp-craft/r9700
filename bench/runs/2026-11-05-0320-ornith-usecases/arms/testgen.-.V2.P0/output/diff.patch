diff --git a/tests/semver.test.ts b/tests/semver.test.ts
new file mode 100644
index 0000000..f00ac37
--- /dev/null
+++ b/tests/semver.test.ts
@@ -0,0 +1,253 @@
+import { describe, it, expect } from "vitest";
+import {
+  parse,
+  compare,
+  satisfiesCaret,
+  bump,
+  maxVersion,
+  SemVerError,
+} from "../src/semver";
+
+describe("parse", () => {
+  it("parses a plain version with no prerelease", () => {
+    expect(parse("1.2.3")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("parses zeros", () => {
+    expect(parse("0.0.0")).toEqual({ major: 0, minor: 0, patch: 0, pre: [] });
+  });
+
+  it("parses multi-digit identifiers as numbers, not strings", () => {
+    expect(parse("10.20.30")).toEqual({ major: 10, minor: 20, patch: 30, pre: [] });
+  });
+
+  it("splits a single prerelease identifier into an array", () => {
+    expect(parse("1.2.3-alpha")).toEqual({ major: 1, minor: 2, patch: 3, pre: ["alpha"] });
+  });
+
+  it("splits multiple prerelease identifiers in order", () => {
+    expect(parse("1.2.3-alpha.beta.1")).toEqual({
+      major: 1,
+      minor: 2,
+      patch: 3,
+      pre: ["alpha", "beta", "1"],
+    });
+  });
+
+  it("parses a numeric prerelease identifier", () => {
+    expect(parse("1.0.0-0")).toEqual({ major: 1, minor: 0, patch: 0, pre: ["0"] });
+  });
+
+  const invalid = [
+    "",
+    "1",
+    "1.2",
+    "1.2.3.4",
+    "v1.2.3",
+    "1.2.x",
+    "-1.2.3",
+    "1.2.3-",
+    "1.2.3-_",
+    "1.2.3+build",
+  ];
+  for (const s of invalid) {
+    it(`throws SemVerError for invalid input: ${JSON.stringify(s)}`, () => {
+      expect(() => parse(s)).toThrow(SemVerError);
+      expect(() => parse(s)).toThrow(/invalid version/);
+    });
+  }
+});
+
+describe("compare", () => {
+  it("returns 0 for equal versions", () => {
+    expect(compare("1.2.3", "1.2.3")).toBe(0);
+    expect(compare("1.2.3-alpha", "1.2.3-alpha")).toBe(0);
+  });
+
+  it("compares major in both directions", () => {
+    expect(compare("2.0.0", "1.9.9")).toBe(1);
+    expect(compare("1.9.9", "2.0.0")).toBe(-1);
+    expect(compare("1.0.0", "2.0.0")).toBe(-1);
+  });
+
+  it("compares minor in both directions", () => {
+    expect(compare("1.2.0", "1.1.9")).toBe(1);
+    expect(compare("1.1.9", "1.2.0")).toBe(-1);
+  });
+
+  it("compares patch in both directions", () => {
+    expect(compare("1.2.4", "1.2.3")).toBe(1);
+    expect(compare("1.2.3", "1.2.4")).toBe(-1);
+  });
+
+  it("sorts a release before its prerelease", () => {
+    expect(compare("1.2.3", "1.2.3-alpha")).toBe(1);
+    expect(compare("1.2.3-alpha", "1.2.3")).toBe(-1);
+  });
+
+  it("compares prerelease identifiers lexically", () => {
+    expect(compare("1.2.3-alpha", "1.2.3-beta")).toBe(-1);
+    expect(compare("1.2.3-beta", "1.2.3-alpha")).toBe(1);
+  });
+
+  it("compares prerelease identifiers numerically", () => {
+    expect(compare("1.2.3-1", "1.2.3-2")).toBe(-1);
+    expect(compare("1.2.3-2", "1.2.3-1")).toBe(1);
+  });
+
+  it("gives numeric identifiers lower precedence than alphanumeric ones", () => {
+    expect(compare("1.2.3-1", "1.2.3-alpha")).toBe(-1);
+    expect(compare("1.2.3-alpha", "1.2.3-1")).toBe(1);
+  });
+
+  it("compares deeper identifiers in order", () => {
+    expect(compare("1.2.3-alpha.1", "1.2.3-alpha.2")).toBe(-1);
+    expect(compare("1.2.3-alpha.2", "1.2.3-alpha.1")).toBe(1);
+  });
+
+  it("orders deeper identifiers numerically, not lexically", () => {
+    expect(compare("1.2.3-alpha.9", "1.2.3-alpha.10")).toBe(-1);
+    expect(compare("1.2.3-alpha.10", "1.2.3-alpha.9")).toBe(1);
+  });
+
+  it("treats a longer identifier set as higher when the prefix is equal", () => {
+    expect(compare("1.2.3-alpha", "1.2.3-alpha.1")).toBe(-1);
+    expect(compare("1.2.3-alpha.1", "1.2.3-alpha")).toBe(1);
+  });
+
+  it("throws for invalid versions", () => {
+    expect(() => compare("bad", "1.2.3")).toThrow(SemVerError);
+    expect(() => compare("1.2.3", "bad")).toThrow(SemVerError);
+  });
+});
+
+describe("satisfiesCaret", () => {
+  describe("^1.2.3 (major > 0, allows <2.0.0)", () => {
+    it("accepts versions at or above the base within the same major", () => {
+      expect(satisfiesCaret("1.2.3", "1.2.3")).toBe(true);
+      expect(satisfiesCaret("1.2.4", "1.2.3")).toBe(true);
+      expect(satisfiesCaret("1.9.9", "1.2.3")).toBe(true);
+    });
+
+    it("rejects below the base or a different major", () => {
+      expect(satisfiesCaret("1.2.2", "1.2.3")).toBe(false);
+      expect(satisfiesCaret("0.9.9", "1.2.3")).toBe(false);
+      expect(satisfiesCaret("2.0.0", "1.2.3")).toBe(false);
+      expect(satisfiesCaret("2.5.0", "1.2.3")).toBe(false);
+    });
+
+    it("rejects a prerelease of the base itself (it sorts below the base)", () => {
+      expect(satisfiesCaret("1.2.3-alpha", "1.2.3")).toBe(false);
+    });
+
+    it("rejects a prereleased version whose x.y.z differs from the base", () => {
+      expect(satisfiesCaret("1.5.0-beta", "1.2.3")).toBe(false);
+    });
+  });
+
+  describe("^0.2.3 (major 0, minor > 0, allows <0.3.0)", () => {
+    it("accepts versions at or above the base within major 0 and minor 2", () => {
+      expect(satisfiesCaret("0.2.3", "0.2.3")).toBe(true);
+      expect(satisfiesCaret("0.2.9", "0.2.3")).toBe(true);
+    });
+
+    it("rejects a different minor, below the base, or a higher major", () => {
+      expect(satisfiesCaret("0.3.0", "0.2.3")).toBe(false);
+      expect(satisfiesCaret("0.1.9", "0.2.3")).toBe(false);
+      expect(satisfiesCaret("1.0.0", "0.2.3")).toBe(false);
+    });
+  });
+
+  describe("^0.0.3 (major and minor 0, allows only 0.0.3)", () => {
+    it("accepts exactly the base", () => {
+      expect(satisfiesCaret("0.0.3", "0.0.3")).toBe(true);
+    });
+
+    it("rejects any other version", () => {
+      expect(satisfiesCaret("0.0.4", "0.0.3")).toBe(false);
+      expect(satisfiesCaret("0.0.2", "0.0.3")).toBe(false);
+      expect(satisfiesCaret("0.1.0", "0.0.3")).toBe(false);
+      expect(satisfiesCaret("0.0.0", "0.0.3")).toBe(false);
+    });
+  });
+
+  it("throws for invalid inputs", () => {
+    expect(() => satisfiesCaret("nope", "1.2.3")).toThrow(SemVerError);
+    expect(() => satisfiesCaret("1.2.3", "nope")).toThrow(SemVerError);
+  });
+});
+
+describe("bump", () => {
+  it("bumps major, resetting minor and patch to 0", () => {
+    expect(bump("1.2.3", "major")).toBe("2.0.0");
+  });
+
+  it("bumps minor, resetting patch to 0", () => {
+    expect(bump("1.2.3", "minor")).toBe("1.3.0");
+  });
+
+  it("bumps patch", () => {
+    expect(bump("1.2.3", "patch")).toBe("1.2.4");
+  });
+
+  it("resets each part when starting from zeros", () => {
+    expect(bump("0.0.0", "major")).toBe("1.0.0");
+    expect(bump("0.0.0", "minor")).toBe("0.1.0");
+    expect(bump("0.0.0", "patch")).toBe("0.0.1");
+  });
+
+  it("handles multi-digit identifiers", () => {
+    expect(bump("10.20.30", "patch")).toBe("10.20.31");
+  });
+
+  it("drops any prerelease", () => {
+    expect(bump("1.2.3-alpha", "major")).toBe("2.0.0");
+    expect(bump("1.2.3-alpha", "minor")).toBe("1.3.0");
+    expect(bump("1.2.3-alpha", "patch")).toBe("1.2.4");
+  });
+
+  it("throws for an invalid version", () => {
+    expect(() => bump("bad", "major")).toThrow(SemVerError);
+  });
+});
+
+describe("maxVersion", () => {
+  it("returns null for an empty list", () => {
+    expect(maxVersion([])).toBeNull();
+  });
+
+  it("returns the single element when there is only one", () => {
+    expect(maxVersion(["1.2.3"])).toBe("1.2.3");
+  });
+
+  it("finds the highest by numeric comparison", () => {
+    expect(maxVersion(["1.0.0", "2.0.0", "1.5.0"])).toBe("2.0.0");
+  });
+
+  it("does not use lexicographic comparison", () => {
+    expect(maxVersion(["1.9.0", "1.10.0"])).toBe("1.10.0");
+    expect(maxVersion(["2.0.0", "1.9.9"])).toBe("2.0.0");
+  });
+
+  it("prefers a release over its prerelease", () => {
+    expect(maxVersion(["1.2.3-alpha", "1.2.3"])).toBe("1.2.3");
+    expect(maxVersion(["1.2.3-alpha", "1.2.4"])).toBe("1.2.4");
+  });
+
+  it("finds the highest prerelease by ordering", () => {
+    expect(maxVersion(["1.0.0-alpha.1", "1.0.0-alpha.2"])).toBe("1.0.0-alpha.2");
+    expect(maxVersion(["1.0.0", "1.0.0-alpha"])).toBe("1.0.0");
+  });
+
+  it("handles ties", () => {
+    expect(maxVersion(["1.0.0", "1.0.0"])).toBe("1.0.0");
+  });
+
+  it("assigns the first element as-is, without validating it", () => {
+    expect(maxVersion(["bad"])).toBe("bad");
+  });
+
+  it("throws once a subsequent invalid entry is compared", () => {
+    expect(() => maxVersion(["1.2.3", "bad"])).toThrow(SemVerError);
+  });
+});
