diff --git a/tests/semver.test.ts b/tests/semver.test.ts
new file mode 100644
index 0000000..7f0a7f1
--- /dev/null
+++ b/tests/semver.test.ts
@@ -0,0 +1,178 @@
+import { describe, it, expect } from "vitest";
+import { parse, SemVerError, compare, satisfiesCaret, bump, maxVersion } from "../src/semver";
+
+describe("parse", () => {
+  it("parses a plain version without prerelease", () => {
+    expect(parse("1.2.3")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("parses zeroed version", () => {
+    expect(parse("0.0.0")).toEqual({ major: 0, minor: 0, patch: 0, pre: [] });
+  });
+
+  it("splits the prerelease into identifiers", () => {
+    expect(parse("1.2.3-rc.1")).toEqual({ major: 1, minor: 2, patch: 3, pre: ["rc", "1"] });
+  });
+
+  it("supports dotted and dashed prerelease identifiers", () => {
+    expect(parse("1.0.0-alpha.1.beta")).toEqual({
+      major: 1,
+      minor: 0,
+      patch: 0,
+      pre: ["alpha", "1", "beta"],
+    });
+  });
+
+  it("throws SemVerError on a malformed version", () => {
+    expect(() => parse("1.2")).toThrow(SemVerError);
+    expect(() => parse("v1.2.3")).toThrow(SemVerError);
+    expect(() => parse("1.2.3-")).toThrow(SemVerError);
+    expect(() => parse("")).toThrow(SemVerError);
+  });
+
+  it("normalizes leading zeros in numeric parts", () => {
+    expect(parse("01.2.3")).toEqual({ major: 1, minor: 2, patch: 3, pre: [] });
+  });
+
+  it("throws on non-numeric parts", () => {
+    expect(() => parse("a.b.c")).toThrow(SemVerError);
+    expect(() => parse("1.2.x")).toThrow(SemVerError);
+  });
+});
+
+describe("compare", () => {
+  it("returns -1 when a is less than b by major/minor/patch", () => {
+    expect(compare("1.0.0", "2.0.0")).toBe(-1);
+    expect(compare("1.1.0", "1.2.0")).toBe(-1);
+    expect(compare("1.2.1", "1.2.2")).toBe(-1);
+  });
+
+  it("returns 1 when a is greater than b", () => {
+    expect(compare("2.0.0", "1.9.9")).toBe(1);
+    expect(compare("1.2.0", "1.1.9")).toBe(1);
+    expect(compare("1.2.3", "1.2.2")).toBe(1);
+  });
+
+  it("returns 0 for equal versions", () => {
+    expect(compare("1.2.3", "1.2.3")).toBe(0);
+    expect(compare("0.0.0", "0.0.0")).toBe(0);
+  });
+
+  it("orders a prerelease below its release", () => {
+    expect(compare("1.0.0-rc.1", "1.0.0")).toBe(-1);
+    expect(compare("1.0.0", "1.0.0-rc.1")).toBe(1);
+  });
+
+  it("compares prerelease identifiers lexicographically when both are text", () => {
+    expect(compare("1.0.0-alpha", "1.0.0-beta")).toBe(-1);
+    expect(compare("1.0.0-ab", "1.0.0-alpha")).toBe(-1); // "ab" < "alpha"
+    expect(compare("1.0.0-alpha.1", "1.0.0-alpha.2")).toBe(-1);
+  });
+
+  it("compares numeric prerelease identifiers numerically", () => {
+    expect(compare("1.0.0-1", "1.0.0-2")).toBe(-1);
+    expect(compare("1.0.0-9", "1.0.0-10")).toBe(-1);
+  });
+
+  it("gives numeric identifiers lower precedence than text identifiers", () => {
+    // per semver: numeric < alphanumeric
+    expect(compare("1.0.0-1", "1.0.0-alpha")).toBe(-1);
+  });
+
+  it("treats a longer prerelease as greater when the prefix matches", () => {
+    expect(compare("1.0.0-alpha", "1.0.0-alpha.1")).toBe(-1);
+    expect(compare("1.0.0-alpha.1", "1.0.0-alpha.2")).toBe(-1);
+  });
+
+  it("orders equal-length prereleases with an empty third component lower", () => {
+    // both share "alpha" then x ends (shorter) -> x < y
+    expect(compare("1.0.0-alpha.beta", "1.0.0-alpha.beta.1")).toBe(-1);
+  });
+});
+
+describe("satisfiesCaret", () => {
+  it("^X.Y.Z allows anything from base up to the next major", () => {
+    expect(satisfiesCaret("1.2.3", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.5.0", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("1.99.99", "1.2.3")).toBe(true);
+    expect(satisfiesCaret("2.0.0", "1.2.3")).toBe(false);
+    expect(satisfiesCaret("1.2.2", "1.2.3")).toBe(false);
+  });
+
+  it("^0.Y.Z allows up to the next minor when Y > 0", () => {
+    expect(satisfiesCaret("0.2.3", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.2.9", "0.2.3")).toBe(true);
+    expect(satisfiesCaret("0.3.0", "0.2.3")).toBe(false);
+    expect(satisfiesCaret("0.1.9", "0.2.3")).toBe(false);
+  });
+
+  it("^0.0.Z allows only the exact patch", () => {
+    expect(satisfiesCaret("0.0.3", "0.0.3")).toBe(true);
+    expect(satisfiesCaret("0.0.4", "0.0.3")).toBe(false);
+    expect(satisfiesCaret("0.0.2", "0.0.3")).toBe(false);
+  });
+
+  it("rejects prereleases whose x.y.z differs from the base", () => {
+    expect(satisfiesCaret("1.3.0-rc.1", "1.2.3")).toBe(false);
+  });
+
+  it("rejects a prerelease that sorts below an exact base", () => {
+    // same x.y.z as base but a prerelease is lower than the release -> below base
+    expect(satisfiesCaret("1.2.3-rc.1", "1.2.3")).toBe(false);
+  });
+
+  it("rejects a prerelease even when its release would fall inside the window", () => {
+    // the x.y.z differs from the base, so the prerelease is rejected outright
+    expect(satisfiesCaret("1.2.4-rc.1", "1.2.3")).toBe(false);
+  });
+
+  it("accepts a plain version whose release sits inside the window", () => {
+    expect(satisfiesCaret("1.2.4", "1.2.3")).toBe(true);
+  });
+});
+
+describe("bump", () => {
+  it("bumps each part and resets lower parts", () => {
+    expect(bump("1.2.3", "major")).toBe("2.0.0");
+    expect(bump("1.2.3", "minor")).toBe("1.3.0");
+    expect(bump("1.2.3", "patch")).toBe("1.2.4");
+  });
+
+  it("resets lower parts from zero", () => {
+    expect(bump("0.0.0", "major")).toBe("1.0.0");
+    expect(bump("0.0.0", "minor")).toBe("0.1.0");
+    expect(bump("0.0.0", "patch")).toBe("0.0.1");
+  });
+
+  it("drops an existing prerelease on bump", () => {
+    expect(bump("1.2.3-rc.1", "major")).toBe("2.0.0");
+    expect(bump("1.2.3-rc.1", "minor")).toBe("1.3.0");
+    expect(bump("1.2.3-rc.1", "patch")).toBe("1.2.4");
+  });
+
+  it("throws on an unparseable version", () => {
+    expect(() => bump("nope", "minor")).toThrow(SemVerError);
+  });
+});
+
+describe("maxVersion", () => {
+  it("returns the highest version in a list", () => {
+    expect(maxVersion(["1.0.0", "2.0.0", "3.0.0"])).toBe("3.0.0");
+  });
+
+  it("compares by full precedence, not lexically", () => {
+    expect(maxVersion(["1.0.0", "1.9.9", "1.10.0", "2.0.0-rc.1"])).toBe("2.0.0-rc.1");
+  });
+
+  it("prefers a release over its prerelease", () => {
+    expect(maxVersion(["1.0.0-rc.1", "1.0.0"])).toBe("1.0.0");
+  });
+
+  it("returns the single element for a one-item list", () => {
+    expect(maxVersion(["5.4.3"])).toBe("5.4.3");
+  });
+
+  it("returns null for an empty list", () => {
+    expect(maxVersion([])).toBeNull();
+  });
+});
