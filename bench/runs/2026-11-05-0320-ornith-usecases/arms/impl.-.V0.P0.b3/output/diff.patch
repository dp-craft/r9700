+/**
+ * logfmt parsing and formatting.
+ *
+ * See SPEC.md for the full contract. In short: a line is zero or more
+ * `key` / `key=value` / `key="quoted value"` pairs separated by spaces/tabs.
+ */
+
+const WHITESPACE = ' \t';
+
+export class LogfmtError extends Error {
+  column: number;
+
+  constructor(message: string, column: number) {
+    super(message);
+    this.name = "LogfmtError";
+    this.column = column;
+    // Keep instanceof working regardless of transpilation target.
+    Object.setPrototypeOf(this, LogfmtError.prototype);
+  }
+}
+
+function isSep(ch: string): boolean {
+  return ch === ' ' || ch === '\t';
+}
+
+export function parse(line: string): Record<string, string | true> {
+  const result: Record<string, string | true> = {};
+  const n = line.length;
+  let i = 0;
+
+  while (i < n) {
+    // Skip one or more separators between pairs.
+    while (i < n && isSep(line[i])) {
+      i++;
+    }
+    if (i >= n) {
+      break;
+    }
+
+    // Parse the key: runs until '=', space, tab or end of line.
+    const keyStart = i;
+    while (i < n && line[i] !== '=' && !isSep(line[i])) {
+      i++;
+    }
+    const key = line.slice(keyStart, i);
+
+    // An empty key means the pair started with '=', so this is the '='.
+    if (key === '') {
+      throw new LogfmtError('empty key', i);
+    }
+
+    // No '=' follows: the value is the boolean true.
+    if (i >= n || isSep(line[i])) {
+      result[key] = true;
+      continue;
+    }
+
+    // line[i] === '=': consume it and read the value.
+    i++;
+
+    if (i < n && line[i] === '"') {
+      result[key] = parseQuoted(line, i);
+    } else {
+      // Bare value: runs until the next space or tab, may contain '='.
+      const valStart = i;
+      while (i < n && !isSep(line[i])) {
+        i++;
+      }
+      result[key] = line.slice(valStart, i);
+    }
+  }
+
+  return result;
+}
+
+/**
+ * Parses a quoted value starting at the opening quote. Returns the decoded
+ * value and advances past the closing quote. Throws LogfmtError on an
+ * unterminated quote or an unknown escape.
+ */
+function parseQuoted(line: string, openQuote: number): string {
+  const n = line.length;
+  let value = '';
+  let i = openQuote + 1;
+
+  while (i < n && line[i] !== '"') {
+    const ch = line[i];
+    if (ch === '\\') {
+      const backslash = i;
+      i++;
+      if (i >= n) {
+        throw new LogfmtError('unterminated escape', backslash);
+      }
+      const esc = line[i];
+      if (esc === '"' || esc === '\\' || esc === 'n') {
+        value += esc === 'n' ? '\n' : esc;
+      } else {
+        throw new LogfmtError('unknown escape', backslash);
+      }
+      i++;
+    } else {
+      value += ch;
+      i++;
+    }
+  }
+
+  if (i >= n) {
+    throw new LogfmtError('unterminated quote', openQuote);
+  }
+
+  // Consume the closing quote. The following character must be a separator
+  // (or end of line); anything else is offensively placed.
+  i++;
+  if (i < n && !isSep(line[i])) {
+    throw new LogfmtError('unexpected text after quoted value', i);
+  }
+
+  return value;
+}
+
+/** Quotes and escapes a value for formatting. */
+function quoteValue(value: string): string {
+  const escaped = value
+    .replace(/\\/g, '\\\\')
+    .replace(/"/g, '\\"')
+    .replace(/\n/g, '\\n');
+  return `"${escaped}"`;
+}
+
+const KEY_BLOCKED = /[ \t="]/;
+const VALUE_BLOCKED = /[ \t"\\=\n]/;
+
+export function format(fields: Record<string, string | true>): string {
+  const parts: string[] = [];
+
+  for (const key of Object.keys(fields)) {
+    if (key === '' || KEY_BLOCKED.test(key)) {
+      throw new LogfmtError('invalid key', -1);
+    }
+
+    const value = fields[key];
+    if (value === true) {
+      parts.push(key);
+    } else if (value.length === 0 || VALUE_BLOCKED.test(value)) {
+      parts.push(`${key}=${quoteValue(value)}`);
+    } else {
+      parts.push(`${key}=${value}`);
+    }
+  }
+
+  return parts.join(' ');
+}
