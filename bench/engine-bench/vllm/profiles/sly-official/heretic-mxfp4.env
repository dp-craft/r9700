# Swift-1.5 heretic GPTQ-MXFP4 + DFlash2 drafter, official Sly docs recipe (see _engine.env). Context = 150000 (user cap; docs use 65536 -- boots on 1.8.1 only with a boot-watchdog floor below the ~250 MiB transient dip, see claude-sly-heretic.sh).
MODEL_DIR=${MODEL_DIR:-$VLLM_ROOT/models/slybase__Swift-1.5-Qwen3.8-27B-heretic-MXFP4-GPTQ@3bb379dc}
DRAFT_DIR=${DRAFT_DIR:-$VLLM_ROOT/models/syvai__Qwen3.8-27B-DFlash2-W4A16@4d30ec73}
SERVED_NAME=${SERVED_NAME:-swift-1.5}
MAXLEN=${MAXLEN:-180000}

MODEL_ENV=(
  RADIANCE_MXFP4=1 RADIANCE_MXFP4_W4A8=1 RADIANCE_MXFP4_W4A8_MIN_M=0
  RADIANCE_MXFP4_DECODE_MAX_M=128 RADIANCE_MXFP4_SANITIZE=0
  RADIANCE_LMHEAD_FP8=1 RADIANCE_LMHEAD_INT4=1 RADIANCE_FUSED_NORM_QUANT=1
  RADIANCE_KV_GROUP_SIZE=8 RADIANCE_EMBED_INT8=1 RADIANCE_EMBED_BITS=4
  RADIANCE_MXFP4_A_TILED_MIN_M=513 RADIANCE_MXFP4_WPERM=1 RADIANCE_MXFP4_WIDE_MAX_M=192
  RADIANCE_ADAPTIVE_WIDTH=perseq
)
MODEL_ARGS=(
  --speculative-config.method dflash
  --speculative-config.model /draft
  --speculative-config.num_speculative_tokens "${SPEC_K:-7}"
  --speculative-config.draft_sample_method probabilistic
  --speculative-config.attention_backend TRITON_ATTN
)
