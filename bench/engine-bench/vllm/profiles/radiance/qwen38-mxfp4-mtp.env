# TWIN of sly-radiance/qwen38-mxfp4-mtp.env on upstream radiance: the target's own MTP head, spec config
# byte-identical to the Sly profile. It is also exactly the MEASURED 2026-09 radiance row's spec config
# (git ~/.config/llama-swap b589e8b, config.yaml:371). --no-async-scheduling is already in _engine.env.
# RADIANCE_DYNAMIC_DRAFT (image default 1) treats k as a CEILING per slot; k=4 is kept for the A/B,
# SPEC_K=8 (upstream compose default) is a separate tuning arm (PLAN.md Task 1b).
source "$(dirname "${BASH_SOURCE[0]}")/qwen38-mxfp4.env"
SERVED_NAME=qwen38-27b-mxfp4-radiance-mtp
SPEC_K=${SPEC_K:-4}

MODEL_ARGS+=(
  --speculative-config "{\"method\":\"mtp\",\"num_speculative_tokens\":$SPEC_K,\"attention_backend\":\"R4D\",\"disable_padded_drafter_batch\":true}"
)
