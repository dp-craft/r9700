# TWIN of sly-radiance/qwen38-mxfp4-dflash.env on upstream radiance: same checkpoint, same drafter
# (syvai/Qwen3.8-27B-DFlash2-W4A16 @4d30ec73), same k=7, same draft_sample_method, same drafter attention
# backend (TRITON_ATTN -- also upstream's documented dflash form, DOCKERHUB.md:248). Only the image differs.
# UNTESTED: 0.9.3 added DFlash2 on 2026-08-25; whether it loads this W4A16 drafter AND the Quark MXFP4
# target is what the first boot answers (PLAN.md Task 1b). Upstream has no Cactus patch (Sly-only,
# sly/patch_cactus.py) -> it runs stock acceptance = Sly at RADIANCE_CACTUS_DELTA=0.
source "$(dirname "${BASH_SOURCE[0]}")/qwen38-mxfp4.env"
SERVED_NAME=qwen38-27b-mxfp4-radiance-dflash
DRAFT_DIR=${DRAFT_DIR:-$VLLM_ROOT/models/syvai__Qwen3.8-27B-DFlash2-W4A16@4d30ec73}
SPEC_K=${SPEC_K:-7}

MODEL_ARGS+=(
  --speculative-config.method dflash
  --speculative-config.model /draft
  --speculative-config.num_speculative_tokens "$SPEC_K"
  --speculative-config.draft_sample_method greedy
  --speculative-config.attention_backend TRITON_ATTN
)
