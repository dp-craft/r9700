# Engine layer: upstream StillDeadcode/vllm-radiance (https://codeberg.org/StillDeadcode/vllm-radiance).
# 0.9.3 (vLLM 0.27.1) is the newest tag on Docker Hub AND the newest code (last commit 2026-08-26, DFlash2
# support), checked 2026-10-23. Env + args = the MEASURED 2026-09 llama-swap row for this image
# (git ~/.config/llama-swap b589e8b, config.yaml:346-371), plus the MODEL-FACING settings copied from
# sly-radiance/_engine.env so the Sly-vs-upstream A/B differs in the ENGINE only:
#   same chat template (Sly's /opt/qwen-fixed.jinja, extracted byte-identical to ../../templates/),
#   same --default-chat-template-kwargs, same --override-generation-config, same parsers.
# Engine-tuned knobs stay each engine's own measured recipe (attention backend R4D vs R4D_HYBRID,
# --max-num-batched-tokens 16384 vs 2048) -- the A/B compares each engine at its best.
# --enforce-eager is on BOTH engines (user decision 2026-10-23), so graph capture is out of the
# comparison; 0.27 honors it the same way 0.31 does (config/vllm.py:1210,1442).
# Flags VERIFIED present in the 0.9.3 source (2026-10-23, CPU-only grep): override-generation-config,
# default-chat-template-kwargs, quark mxfp4 scheme, dflash, R4D, anthropic /v1/messages.
# NOT copied from Sly: --mamba-ssm-cache-dtype bfloat16 (Sly-tuned, not in the measured radiance row)
# and the KVCACHE=ram tier (Sly patches only).
IMAGE=${IMAGE:-stilldeadcode/vllm-radiance:0.9.3}
GPU_UTIL=${GPU_UTIL:-0.90}
MAXSEQS=${MAXSEQS:-1}
KV_DTYPE=${KV_DTYPE:-fp8}
FREE_MIB_FLOOR=${FREE_MIB_FLOOR:-30000}
# radiance ships no .jinja in /opt (checked 2026-10-22) -> mount the Sly template; serve_vllm.sh
# turns CHAT_TEMPLATE into a read-only mount + --chat-template. An explicit CHAT_TEMPLATE= still wins.
CHAT_TEMPLATE=${CHAT_TEMPLATE:-$HERE/templates/qwen-fixed-sly-1.6.0.jinja}
CACHE_MOUNTS=(cache:/cache)
ENGINE_ENV=(
  # 2026-10-23: kernel args in HOST memory. Default (device kernargs written over the PCIe BAR) gave random
  # HSA_STATUS_ERROR_MEMORY_FAULTs in any kernel, the address = a valid pointer with bit 44 cleared, ~50-80% of
  # boots on the first Claude request; with this: 3/3 boots x 4 turns clean, same speed
  # (docs/plans/2026-10-22-mxfp4-qwen38-options/FASTPATH.md, hostka-1..3).
  HIP_FORCE_DEV_KERNARG=0
  HIP_VISIBLE_DEVICES=0
  # The MEASURED gfx1201 AITER matrix: unified attention ON, every fused AITER path OFF -- they are tuned
  # for CDNA and are slower OR NUMERICALLY WRONG on RDNA4 (generate.py VLLM_ENV). Restored 2026-10-23:
  # the first version of this file had dropped the =0 half, a quality risk, not just a speed one.
  VLLM_ROCM_USE_AITER=1 VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=1
  VLLM_ROCM_USE_AITER_MHA=0 VLLM_ROCM_USE_AITER_MLA=0 VLLM_ROCM_USE_AITER_MOE=0
  VLLM_ROCM_USE_AITER_LINEAR=0 VLLM_ROCM_USE_AITER_FP8BMM=0 VLLM_ROCM_USE_AITER_FP4BMM=0
  VLLM_ROCM_USE_AITER_RMSNORM=0
  VLLM_CACHE_ROOT=/cache/vllm TORCHINDUCTOR_CACHE_DIR=/cache/inductor
  TRITON_CACHE_DIR=/cache/triton AITER_ROOT_DIR=/cache/aiter TRITON_CACHE_AUTOTUNING=1
  # radiance's drafter stack, measured with MTP-4 (58.6 tok/s, 2026-09). Each half engages only where it
  # applies (DOCKERHUB.md), so it is inert on a profile without speculation.
  RADIANCE_FAST_DRAFT=1 RADIANCE_DRAFT_TAU=0.28 RADIANCE_SKINNY_GEMM=all
)
ENGINE_ARGS=(
  --max-num-seqs "$MAXSEQS" --gpu-memory-utilization "$GPU_UTIL" --kv-cache-dtype "$KV_DTYPE"
  --max-num-batched-tokens 16384
  --enforce-eager
  --attention-backend R4D --enable-prefix-caching --mamba-cache-mode align
  --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3
  --default-chat-template-kwargs '{"reasoning_effort": "medium"}'
  --override-generation-config '{"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.1}'
  --enable-force-include-usage --enable-prompt-tokens-details
  --no-async-scheduling
)
