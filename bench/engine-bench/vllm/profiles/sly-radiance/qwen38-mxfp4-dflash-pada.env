# qwen38-mxfp4-dflash + the PAD_A overlay (overlays/sly-pad-a): A and x_scale get a zeroed 256-row tail
# before every W4A8 prefill GEMM, so the kernel's tile over-read (M=1760 -> 7x256 rows) stays in owned memory.
# Everything else identical to qwen38-mxfp4-dflash (2026-10-22 fault fix under test).
source "$(dirname "${BASH_SOURCE[0]}")/qwen38-mxfp4-dflash.env"
PY_OVERLAY=${PY_OVERLAY:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../overlays/sly-pad-a" && pwd)}
