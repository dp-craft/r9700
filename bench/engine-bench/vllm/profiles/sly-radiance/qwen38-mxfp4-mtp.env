# Model A + the target's OWN MTP head (no separate drafter) -- the no-DFlash speculative arm.
# MTP head VERIFIED present 2026-10-23: config.json mtp_num_hidden_layers=1, safetensors header holds 15
# BF16 mtp.* tensors (unquantized). Spec config verbatim from Sly's serve.sh SPEC_METHOD=mtp branch
# (src/v1.6.0/serve.sh:155-159, "measured default 4"), with its ASYNC=0 default: --no-async-scheduling
# + disable_padded_drafter_batch true. JSON form, not dotted keys: a dotted `...=true` reaches vLLM as
# a string, and Sly's run_autoround.sh:89 records argparse rejecting a non-JSON spec config.
# Sly #164 (Cactus repetition lock): Cactus patches vLLM's V2-runner rejection kernel for ANY sampled
# (temp>0) spec request, and the V2 runner is the 0.31 default for ROCm Qwen3.8 + dflash
# (sly/patch_cactus.py docstring). Whether MTP runs on V2 is UNVERIFIED -> treat MTP as exposed too.
# delta 0.5 is lossy by design (README: "more drift from the target distribution"); 0 = bit-exact stock.
# Twin: radiance/qwen38-mxfp4-mtp.env (same model, k, template, sampler) for the Sly-vs-upstream A/B.
source "$(dirname "${BASH_SOURCE[0]}")/qwen38-mxfp4.env"
SERVED_NAME=qwen38-27b-mxfp4-mtp
SPEC_K=${SPEC_K:-4}
# Upstream config.json lists the BF16 MTP head in quantization_config.exclude as "mtp.*.weight"; vLLM matches
# layer names, so they miss and the head is built as MXFP4 -> shape assert at load (2026-10-23). The overlay
# strips ".weight" from those 15 entries only (overlays/qwen38-mxfp4-mtp-config/SOURCE.txt).
MODEL_CONFIG=${MODEL_CONFIG:-$HERE/overlays/qwen38-mxfp4-mtp-config/config.json}

MODEL_ARGS+=(
  --speculative-config "{\"method\":\"mtp\",\"num_speculative_tokens\":$SPEC_K,\"attention_backend\":\"R4D\",\"disable_padded_drafter_batch\":true}"
  --no-async-scheduling
)
# one seq x (k=4 + 1) = 5 tokens per decode step; the engine default [1,2,4,8] pads it to 8.
