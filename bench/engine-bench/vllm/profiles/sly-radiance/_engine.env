# Engine layer: SlyBase/vllm-sly-radiance (https://github.com/SlyBase/vllm-sly-radiance).
# Sourced by serve_vllm.sh AFTER the model profile: every knob here is ${VAR:-default}, so the
# command line beats the model profile, which beats this file.
# Recipe = the repo README "single R9700" quickstart (src/v1.6.0/README.md), with these deliberate
# deviations, each a host property rather than a tuning choice:
#   GPU_UTIL 0.90 (README 0.98): the desktop GUI shares this card (CLAUDE.md, Gemma device-loss).
#   --shm-size instead of --ipc=host; -p bound to 127.0.0.1; numeric GIDs read from this host.
#   speculative decoding OFF until the drafter is evaluated separately (README uses DFlash2 k=7).
# Upgrade = change IMAGE (or IMAGE=... on the command line); caches are keyed by the tag.

IMAGE=${IMAGE:-ghcr.io/slybase/vllm-sly-radiance:1.6.0-rocm10.1}
GPU_UTIL=${GPU_UTIL:-0.90}
MAXSEQS=${MAXSEQS:-8}
KV_DTYPE=${KV_DTYPE:-fp8}
FREE_MIB_FLOOR=${FREE_MIB_FLOOR:-30000}   # gpu_exclusive.sh precondition (iron rule 14)

# container-side cache paths; serve_vllm.sh mounts $CACHE_DIR/{root-cache,triton,aiter} onto them
CACHE_MOUNTS=(root-cache:/root/.cache triton:/root/.triton aiter:/root/.aiter)

ENGINE_ENV=(
  HIP_VISIBLE_DEVICES=0
  GPU_MAX_HW_QUEUES=2
  TORCHINDUCTOR_CACHE_DIR=/root/.cache/inductor
  RADIANCE_RUN_BWTEST=0   # image default 1: a P2P bandwidth self-test at every start; diagnostic only
)

ENGINE_ARGS=(
  --max-num-seqs "$MAXSEQS"
  --gpu-memory-utilization "$GPU_UTIL"
  --kv-cache-dtype "$KV_DTYPE"
  --mamba-ssm-cache-dtype bfloat16
  --attention-backend R4D_HYBRID
  --max-num-batched-tokens 2048
  --compilation-config.cudagraph_mode FULL_DECODE_ONLY
  --compilation-config.cudagraph_capture_sizes "${CUDAGRAPH_SIZES:-[1,2,4,8]}"
  --enable-prefix-caching
  --skip-mm-profiling --enable-mm-embeds
  --limit-mm-per-prompt.image 0 --limit-mm-per-prompt.video 0
  --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3
  --chat-template /opt/qwen-fixed.jinja
  --default-chat-template-kwargs '{"reasoning_effort": "medium"}'
  --override-generation-config '{"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0}'
  --enable-force-include-usage --enable-prompt-tokens-details
)
