# qwen35-35b-a3b-mxfp4.env + z-lab DFlash drafter (block diffusion, arch DFlashDraftModel, vLLM `dflash` method).
# Drafter: z-lab/Qwen3.5-35B-A3B-DFlash@52cb554b -- the EXACT-release drafter: base_model Qwen/Qwen3.5-35B-A3B
# (MEASURED from the repo config, 2026-11-04) = the parent of amd/Qwen3.5-35B-A3B-MXFP4, so trained for this
# model family. 6 layers 5-SWA+1-full, hidden 2048, vocab 248320, block_size 16, ~772 MB BF16; geometry
# verified against the base (40 layers, num_target_layers=40, mask_token_id 248077 < vocab).
# Cross-release alternative (same config, trained on Qwen3.6 weights): z-lab/Qwen3.6-35B-A3B-DFlash@f181eece --
# fetch it, then override DRAFT_DIR=$VLLM_ROOT/models/z-lab__Qwen3.6-35B-A3B-DFlash@f181eece to compare accept
# lengths (A/B).
# SPEC_K default 7 = the 27b's value. K=16 (the drafter config's block_size) does NOT fit ctx 262000 at util 0.93:
# MEASURED bench/runs/2026-11-04-1527-35b-kv-fit -- K=16 needs 4.48 GiB vs 3.43 available even at group size 1.
# VLLM_USE_V2_MODEL_RUNNER=1 is REQUIRED: this drafter is mixed sliding/full attention, and upstream
# qwen3_dflash.py raises without the V2 runner (both verified present in image 1.9.1, CPU-only probe).
# Draft attention TRITON_ATTN: supports the non-causal draft pass (same as the 27b DFlash2 arm).
# set BEFORE sourcing: the base file only defaults SERVED_NAME (${VAR:-...}), so the first definition wins
SERVED_NAME=${SERVED_NAME:-qwen35-35b-a3b-mxfp4-dflash}
source "$(dirname "${BASH_SOURCE[0]}")/qwen35-35b-a3b-mxfp4.env"
# Fetch: bench/engine-bench/vllm/fetch_model.sh z-lab/Qwen3.5-35B-A3B-DFlash 52cb554b4995dede3e2e1bdb129cdb1f3529332b
DRAFT_DIR=${DRAFT_DIR:-$VLLM_ROOT/models/z-lab__Qwen3.5-35B-A3B-DFlash@52cb554b}
SPEC_K=${SPEC_K:-7}

MODEL_ENV+=(
  VLLM_USE_V2_MODEL_RUNNER=1
)
MODEL_ARGS+=(
  --speculative-config.method dflash
  --speculative-config.model /draft
  --speculative-config.num_speculative_tokens "${SPEC_K:-7}"
  --speculative-config.draft_sample_method probabilistic
  --speculative-config.attention_backend TRITON_ATTN
)
