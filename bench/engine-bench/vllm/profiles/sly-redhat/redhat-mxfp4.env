# RedHatAI/Qwen3.8-27B-MXFP4 (llm-compressor, compressed-tensors mxfp4-pack-quantized) on the sly-official engine layer
# (1.8.1, official Swift-heretic recipe flag for flag; sourced via sly-redhat/_engine.env -- these profiles lived in
# sly-official/ until 2026-10-30, so runs before that record profile=sly-official/redhat-mxfp4*).
# Same checkpoint family/loader path as sly-official/heretic-mxfp4.env, so the
# MXFP4 env block is copied from it. Differences from heretic-mxfp4.env: model, NO speculative decoding (engine-vs-engine
# comparison without a drafter; the checkpoint's own model_mtp.safetensors is not enabled), MAXLEN 110000 (probes <=100k).
# No --quantization flag: config.json says compressed-tensors.
# Fetch: bench/engine-bench/vllm/fetch_model.sh RedHatAI/Qwen3.8-27B-MXFP4 16a86728c6e2a5023e7dd5e68100ceff24abe5d7
MODEL_DIR=${MODEL_DIR:-$VLLM_ROOT/models/RedHatAI__Qwen3.8-27B-MXFP4@16a86728}
SERVED_NAME=${SERVED_NAME:-qwen38-27b-redhat-mxfp4-sly}
MAXLEN=${MAXLEN:-110000}

MODEL_ENV=(
  RADIANCE_MXFP4=1 RADIANCE_MXFP4_W4A8=1 RADIANCE_MXFP4_W4A8_MIN_M=0
  RADIANCE_MXFP4_DECODE_MAX_M=128 RADIANCE_MXFP4_SANITIZE=0
  RADIANCE_LMHEAD_FP8=1 RADIANCE_LMHEAD_INT4=1 RADIANCE_FUSED_NORM_QUANT=1
  RADIANCE_KV_GROUP_SIZE=8 RADIANCE_EMBED_INT8=1 RADIANCE_EMBED_BITS=4
  RADIANCE_MXFP4_A_TILED_MIN_M=513 RADIANCE_MXFP4_WPERM=1 RADIANCE_MXFP4_WIDE_MAX_M=192
  RADIANCE_ADAPTIVE_WIDTH=perseq
)
MODEL_ARGS=()
