# redhat-mxfp4.env + the checkpoint's OWN MTP head (no drafter). Head VERIFIED 2026-10-30: config mtp_num_hidden_layers=1,
# 15 BF16 mtp.* tensors in model_mtp.safetensors (listed in model.safetensors.index.json), excluded from quantization by the
# regex 're:^mtp.*' (compressed-tensors) -- so NO MODEL_CONFIG overlay (that fixed the Quark "mtp.*.weight" exclude bug only).
# Spec config = sly-radiance/qwen38-mxfp4-mtp.env (Sly serve.sh SPEC_METHOD=mtp, k=4, JSON form). Engine layer already sets
# --no-async-scheduling. Cactus stays at the sly-official default 0.5 (same as the heretic+DFlash reference run).
# set BEFORE sourcing: the base file only defaults SERVED_NAME (${VAR:-...}), so the first definition wins
SERVED_NAME=${SERVED_NAME:-qwen38-27b-redhat-mxfp4-mtp}
source "$(dirname "${BASH_SOURCE[0]}")/redhat-mxfp4.env"
SPEC_K=${SPEC_K:-4}
MODEL_ARGS+=(
  --speculative-config "{\"method\":\"mtp\",\"num_speculative_tokens\":$SPEC_K,\"attention_backend\":\"R4D\",\"disable_padded_drafter_batch\":true}"
)
