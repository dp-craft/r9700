# redhat-mxfp4.env + DFlash2 drafter, spec args verbatim from heretic-mxfp4.env (official Sly recipe, k=7, probabilistic draft sampling).
# Drafter syvai/Qwen3.8-27B-DFlash2-W4A16 targets the Qwen3.8-27B base; this checkpoint is the same base re-quantized (compat is the thing under test).
# set BEFORE sourcing: the base file only defaults SERVED_NAME (${VAR:-...}), so the first definition wins
SERVED_NAME=${SERVED_NAME:-qwen38-27b-redhat-mxfp4-dflash}
source "$(dirname "${BASH_SOURCE[0]}")/redhat-mxfp4.env"
DRAFT_DIR=${DRAFT_DIR:-$VLLM_ROOT/models/syvai__Qwen3.8-27B-DFlash2-W4A16@4d30ec73}
MODEL_ARGS+=(
  --speculative-config.method dflash
  --speculative-config.model /draft
  --speculative-config.num_speculative_tokens "${SPEC_K:-7}"
  --speculative-config.draft_sample_method probabilistic
  --speculative-config.attention_backend TRITON_ATTN
)
