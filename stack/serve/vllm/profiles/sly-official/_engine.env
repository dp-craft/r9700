# Engine layer "sly-official": the Sly docs' single-R9700 docker command for Swift-1.5 heretic, flag for flag
# (user decision 2026-10-24: follow the official values, except the context window; the 27B window/seqs come from
# stack/serve/27b.conf — MAXLEN 260000, MAXSEQS 2, user decision 2026-10-25, DC1 re-tune 2026-11-09).
# Separate from sly-radiance/_engine.env, whose host-driven deviations (eager, drafter off, Cactus off, util 0.90,
# prefix caching on) stay as they are for the other profiles.
# Deviations from the official command, all host properties or bookkeeping:
#   --max-model-len 260000 (user, 27b.conf — the engine layer's MAXSEQS 1 is overridden per-model)  --shm-size/-p 127.0.0.1/numeric GIDs/--device (see serve_vllm.sh)
#   TORCHINDUCTOR_CACHE_DIR (cache mount)
#   enable_thinking true (user, docs: false)  HIP_FORCE_DEV_KERNARG fix deliberately NOT set (user, 2026-10-24; docs don't set it either)
#   --enable-force-include-usage --enable-prompt-tokens-details (usage accounting only)
#   drafter read from the pinned local snapshot (/draft) instead of the HF id syvai/Qwen3.8-27B-DFlash2-W4A16
#   --enable-prefix-caching (2026-10-25: deviates from official, which had --no-enable-prefix-caching —
#     agentic sessions re-send the full history each turn, so prefix reuse is required; smoke-test first)

IMAGE=${IMAGE:-ghcr.io/slybase/vllm-sly-radiance:1.8.1-rocm10.1}
GPU_UTIL=${GPU_UTIL:-0.93}
MAXSEQS=${MAXSEQS:-1}
KV_DTYPE=${KV_DTYPE:-fp8}
FREE_MIB_FLOOR=${FREE_MIB_FLOOR:-30000}   # gpu_exclusive.sh precondition (iron rule 14)

CACHE_MOUNTS=(root-cache:/root/.cache triton:/root/.triton aiter:/root/.aiter)

ENGINE_ENV=(
  HIP_VISIBLE_DEVICES=0
  GPU_MAX_HW_QUEUES=1
  TORCHINDUCTOR_CACHE_DIR=/root/.cache/inductor
  RADIANCE_CACTUS_DELTA=${CACTUS_DELTA:-0.5}
  # Sly 1.9.x Cactus fade/cap knobs: UNSET = no -e line (image default applies); SET = -e RADIANCE_CACTUS_*=<value>.
  # (unquoted :+ expansion: an unset knob yields no array element at all, safe under set -u)
  #   CACTUS_FADE_START  tokens of output before delta starts fading        (image default 4096)
  #   CACTUS_FADE_END    output length at which delta reaches 0              (image default 16384)
  #                      per request: fade = clamp((END - out_len)/max(END - START, 1), 0, 1), out_len = pos - prompt_len;
  #                      req_delta = CACTUS_DELTA * fade. END=0 DISABLES the fade (constant delta, 1.8.1 behaviour).
  #   CACTUS_CAP_R       h = min(h, 1 - R*(1 - q)), R in [0,1] (else the engine raises at import)  (image default 0.5)
  #                      R=0 DISABLES the cap (h <= 1 is already guaranteed).
  #   1.8.1-like Cactus on 1.9.1: CACTUS_FADE_END=0 CACTUS_CAP_R=0. CACTUS_DELTA=0 = Cactus off (stock acceptance).
  #   Read from rejection_sampler_utils.py:10-16,775-783 in image vllm-sly-radiance:1.9.1-rocm10.1 (code read, not a runtime measurement);
  #   the 1.8.1-rocm10.1 image reads only RADIANCE_CACTUS_DELTA, so these knobs are silently ignored there.
  ${CACTUS_FADE_START:+RADIANCE_CACTUS_FADE_START=$CACTUS_FADE_START}
  ${CACTUS_FADE_END:+RADIANCE_CACTUS_FADE_END=$CACTUS_FADE_END}
  ${CACTUS_CAP_R:+RADIANCE_CACTUS_CAP_R=$CACTUS_CAP_R}
)

ENGINE_ARGS=(
  --max-num-seqs "$MAXSEQS"
  --gpu-memory-utilization "$GPU_UTIL"
  --kv-cache-dtype "$KV_DTYPE"
  --mamba-ssm-cache-dtype bfloat16
  --attention-backend R4D_HYBRID
  --max-num-batched-tokens 4096
  --compilation-config.cudagraph_mode FULL_DECODE_ONLY
  --compilation-config.cudagraph_capture_sizes '[8,16,24,32,40,48,56,64]'
  --enable-prefix-caching --no-async-scheduling
  --skip-mm-profiling --enable-mm-embeds
  --limit-mm-per-prompt.image 0 --limit-mm-per-prompt.video 0
  --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3
  --chat-template /opt/qwen-fixed.jinja
  --default-chat-template-kwargs '{"enable_thinking": true}'
  --override-generation-config '{"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0}'
  --enable-force-include-usage --enable-prompt-tokens-details
)
