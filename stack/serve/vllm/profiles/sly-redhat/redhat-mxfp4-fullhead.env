# redhat-mxfp4.env with the lm head NOT quantized: RADIANCE_LMHEAD_FP8 / RADIANCE_LMHEAD_INT4 dropped from MODEL_ENV,
# everything else identical. Diagnostic for campaigns/perf/2026-11-09-1825-27b-arms-kld (2026-11-12): the sly arms
# diverge from every other arm at the first tokens; the quantized lm head is the INFERRED cause, this profile tests it.
# set BEFORE sourcing: the base file only defaults SERVED_NAME (${VAR:-...}), so the first definition wins
SERVED_NAME=${SERVED_NAME:-qwen38-27b-redhat-mxfp4-fullhead}
source "$(dirname "${BASH_SOURCE[0]}")/redhat-mxfp4.env"
_env=()
for _e in "${MODEL_ENV[@]}"; do
  case "$_e" in RADIANCE_LMHEAD_FP8=*|RADIANCE_LMHEAD_INT4=*) ;; *) _env+=("$_e") ;; esac
done
MODEL_ENV=("${_env[@]}")
unset _env _e
