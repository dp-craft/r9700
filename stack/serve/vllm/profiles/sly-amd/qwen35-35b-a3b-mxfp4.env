# amd/Qwen3.5-35B-A3B-MXFP4 (parent Qwen/Qwen3.5-35B-A3B-FP8, AMD-Quark OCP MXFP4: static E2M1 weights +
# E8M0 block scales group 32, dynamic activations) on the sly-official engine layer (sly-redhat image 1.9.1).
# Arch: qwen3_5_moe / Qwen3_5MoeForConditionalGeneration, hybrid 40 layers (10 full-attn + 30 linear-attn),
# hidden 2048, 256 experts x top-8, vocab 248320, max pos 262144, mtp_num_hidden_layers=1 (MTP tensors ship
# inside the main shards, bf16 via the quark exclude list).
# No --quantization flag: config.json carries the quark quantization_config; "quark" is a registered vLLM
# quant method (verified in image 1.9.1, 2026-11-04 CPU-only docker probe). The exclude list names modules
# WITHOUT a .weight suffix (the form quark matches) -- unlike the RedHatAI-27B tensor-name trap.
# MODEL_ENV MXFP4 kernel family copied from sly-redhat/redhat-mxfp4.env (same OCP MXFP4 format).
# INFERRED, not yet MEASURED: kernel coverage of MoE expert GEMMs + linear-attn layers -- the first GPU boot
# is the test (see stack/serve/vllm/tests/validate-vllm-35b.sh).
# Fetch: stack/serve/vllm/fetch_model.sh amd/Qwen3.5-35B-A3B-MXFP4 2e19c6576db91e5d5a93455415619262218bf8a1
MODEL_DIR=${MODEL_DIR:-$VLLM_ROOT/models/amd__Qwen3.5-35B-A3B-MXFP4@2e19c657}
SERVED_NAME=${SERVED_NAME:-qwen35-35b-a3b-mxfp4-sly}
MAXLEN=${MAXLEN:-262000}

# Chat template: the model's OWN chat_template.jinja (shipped in the snapshot, mounted at /model).
# The engine layer's /opt/qwen-fixed.jinja is a Qwen3.8 artifact -- not for this family. A launcher-level
# CHAT_TEMPLATE=... (e.g. templates/dp-sharp-chat_template.jinja) still wins; before the fetch the file is
# absent and the engine default applies, so `print` works pre-fetch and never boots with a missing template.
[ -n "${CHAT_TEMPLATE:-}" ] || [ -f "$MODEL_DIR/chat_template.jinja" ] && CHAT_TEMPLATE="$MODEL_DIR/chat_template.jinja"

# KV group size 2, NOT the 27b's 8: layer buckets here are [30,10,5,1], and 8 pads 10->16 and the drafter's 1->8.
# MEASURED with DFlash at ctx 262000 (campaigns/perf/2026-11-04-1527-ornith15-radiance-vs-sly/results/2026-11-04-1527-35b-kv-fit): K=16 gs 8 needs 9.65 GiB, gs 5 6.48, gs 1 4.48;
# K=7 gs 5 needs 5.71 and misses by 1.04, gs 2 boots with 305,666 tokens (1.17x), gs 1 with 348,641 (1.33x, higher VRAM peak).
MODEL_ENV=(
  RADIANCE_MXFP4=1 RADIANCE_MXFP4_W4A8=1 RADIANCE_MXFP4_W4A8_MIN_M=0
  RADIANCE_MXFP4_DECODE_MAX_M=128 RADIANCE_MXFP4_SANITIZE=0
  RADIANCE_LMHEAD_FP8=1 RADIANCE_LMHEAD_INT4=1 RADIANCE_FUSED_NORM_QUANT=1
  RADIANCE_KV_GROUP_SIZE=${KV_GROUP_SIZE:-2} RADIANCE_EMBED_INT8=1 RADIANCE_EMBED_BITS=4
  RADIANCE_MXFP4_A_TILED_MIN_M=513 RADIANCE_MXFP4_WPERM=1 RADIANCE_MXFP4_WIDE_MAX_M=192
  RADIANCE_ADAPTIVE_WIDTH=perseq
)
MODEL_ARGS=()
