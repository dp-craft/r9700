# qwen35-35b-a3b-mxfp4.env + the checkpoint's OWN MTP head (no drafter). Head MEASURED 2026-11-04: config
# mtp_num_hidden_layers=1, 785 mtp.* tensors = 1.57 GiB BF16 (one 256-expert layer, safetensors headers), listed in the
# quark exclude list without a .weight suffix -- so no MODEL_CONFIG overlay. NOT lighter than the DFlash drafter (1.36 GiB).
# Spec config = sly-redhat/redhat-mxfp4-mtp.env (k=4, JSON form) except the attention backend: R4D refuses this head
# (MEASURED: "R4D attention does not support gqa=8, needs == 6"), hence TRITON_ATTN. Engine layer sets --no-async-scheduling.
# set BEFORE sourcing: the base file only defaults SERVED_NAME (${VAR:-...}), so the first definition wins
SERVED_NAME=${SERVED_NAME:-qwen35-35b-a3b-mxfp4-mtp}
source "$(dirname "${BASH_SOURCE[0]}")/qwen35-35b-a3b-mxfp4.env"
SPEC_K=${SPEC_K:-4}
MODEL_ARGS+=(
  --speculative-config "{\"method\":\"mtp\",\"num_speculative_tokens\":$SPEC_K,\"attention_backend\":\"TRITON_ATTN\",\"disable_padded_drafter_batch\":true}"
)
