# Model A + DFlash2 speculative decoding = the Sly README quickstart's full single-R9700 recipe.
# Drafter: syvai/Qwen3.8-27B-DFlash2-W4A16 (W4A16 quant of incoai/Qwen3.8-27B-DFlash2, Apache-2.0,
# safetensors + config only — no remote code). Spec args verbatim from src/v1.6.0/README.md.
# CLAIMED there: 149.6 tok/s single-stream decode (1.5.1, 300 W, util 0.98) -- not this box's setup.
# Watch: Sly issue #164 (open) -- Cactus acceptance may lock into repetition on long outputs.
# 2026-10-23 (user decision): the engine layer now defaults RADIANCE_CACTUS_DELTA to 0 (off);
# CACTUS_DELTA=0.5 restores the image default.
source "$(dirname "${BASH_SOURCE[0]}")/qwen38-mxfp4.env"
SERVED_NAME=qwen38-27b-mxfp4-dflash
DRAFT_DIR=${DRAFT_DIR:-$VLLM_ROOT/models/syvai__Qwen3.8-27B-DFlash2-W4A16@4d30ec73}
SPEC_K=${SPEC_K:-7}

MODEL_ARGS+=(
  --speculative-config.method dflash
  --speculative-config.model /draft
  --speculative-config.num_speculative_tokens "$SPEC_K"
  --speculative-config.draft_sample_method greedy
  --speculative-config.attention_backend TRITON_ATTN
)
# Dormant under --enforce-eager; if the engine layer's FULL_DECODE_ONLY flag comes back, this
# profile's [8] (one seq x (k=7 + 1); the README's [8..64] assume 8 seqs) applies again.
CUDAGRAPH_SIZES=${CUDAGRAPH_SIZES:-'[8]'}
