# Model H: Swift-1.5 Qwen3.8-27B heretic (abliterated, research-only) as GPTQ-MXFP4 compressed-tensors checkpoint
# slybase/Swift-1.5-Qwen3.8-27B-heretic-MXFP4-GPTQ -- the vLLM-loadable source of the heretic .rad (a .rad only loads in
# native radiance, see claude/claude-rad-heretic.sh). Sly calls it its "production" checkpoint (docs/TECHNICAL.md:756).
# Same MXFP4 W4A8 env as Model A (qwen38-mxfp4.env) plus the two extras from /mnt/Lin1/work/vllm/sly-radiance/run.sh.
# No --quantization flag: the checkpoint's config.json says compressed-tensors, vLLM picks it up (run.sh did the same).
# Fetch: bench/engine-bench/vllm/fetch_model.sh slybase/Swift-1.5-Qwen3.8-27B-heretic-MXFP4-GPTQ 3bb379dcbb1b5522ae28588df6292168f519df19
# set BEFORE sourcing: Model A's file only defaults these (${VAR:-...}), so the first definition wins
MODEL_DIR=${MODEL_DIR:-$VLLM_ROOT/models/slybase__Swift-1.5-Qwen3.8-27B-heretic-MXFP4-GPTQ@3bb379dc}
SERVED_NAME=${SERVED_NAME:-swift-1.5-heretic}
source "$(dirname "${BASH_SOURCE[0]}")/qwen38-mxfp4.env"
MODEL_ENV+=(RADIANCE_MXFP4_SANITIZE=0 RADIANCE_LMHEAD_FP8=1)
MODEL_ARGS=()
