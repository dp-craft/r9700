# Model A2: unsloth NVFP4, requantized to MXFP4 at load -> same W4A8 fp8-WMMA kernels as model A.
# Sly docs/BENCHMARKS.md: "same image and the same production arguments, only --model /
# --quantization and the format switch changed" -> reuse A's env and add the switch.
source "$(dirname "${BASH_SOURCE[0]}")/qwen38-mxfp4.env"
MODEL_DIR=$VLLM_ROOT/models/unsloth__Qwen3.8-27B-NVFP4@f0b7c9e7
SERVED_NAME=qwen38-27b-nvfp4
MODEL_ENV+=(RADIANCE_NVFP4_MXFP4=1)
MODEL_ARGS=(--quantization compressed-tensors)
