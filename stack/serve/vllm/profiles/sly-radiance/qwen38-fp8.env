# Model B: official Qwen FP8 (block-128 E4M3) -- QUALITY REFERENCE, not a speed candidate.
# Sly tests this checkpoint mainly at TP=2. On one card the weights alone are ~25 GiB (INFERRED:
# Sly's 12.6 GiB/GPU at TP=2 x 2), so the window is small and the boot itself may fail -- the
# boot result IS the first measurement. No RADIANCE_* 4-bit tricks (int4 lm_head, int8 embed):
# they would change the reference we compare the 4-bit models against.
MODEL_DIR=${MODEL_DIR:-$VLLM_ROOT/models/Qwen__Qwen3.8-27B-FP8@017b9c7a}
SERVED_NAME=${SERVED_NAME:-qwen38-27b-fp8}
MAXLEN=${MAXLEN:-16384}
MAXSEQS=${MAXSEQS:-1}
GPU_UTIL=${GPU_UTIL:-0.95}

MODEL_ENV=()
MODEL_ARGS=(--language-model-only)   # Sly DOCKERHUB.md: skips the vision tower for text serving
