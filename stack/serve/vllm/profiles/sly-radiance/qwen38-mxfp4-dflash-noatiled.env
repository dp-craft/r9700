# qwen38-mxfp4-dflash with the fragment-tiled A prefill GEMM OFF (RADIANCE_MXFP4_A_TILED_MIN_M=0,
# the image default; the README quickstart sets 513). Every GPU memory fault seen so far (3 of ~90
# requests, 2026-10-22) was in radiance_mxfp4_fp8_gemm_atiled; with 0 that kernel is never dispatched
# and prefill uses the folded kernel. CLAIMED cost (radiance_mxfp4.py:29-33): <=12-16 % prefill at
# M >= 2048; decode unaffected (decode band reads row-major A). See
# docs/analysis/2026-10-22-1643-vllm-mxfp4-atiled-fault-and-llama-swap-serving.md.
source "$(dirname "${BASH_SOURCE[0]}")/qwen38-mxfp4-dflash.env"
MODEL_ENV=("${MODEL_ENV[@]/RADIANCE_MXFP4_A_TILED_MIN_M=513/RADIANCE_MXFP4_A_TILED_MIN_M=0}")
