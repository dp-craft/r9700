# ============================================================
# STARTER — the canonical MINIMAL config: the smallest profile that boots the MXFP4 track.
# Use it as the known-good baseline before adding a drafter / Cactus / a larger context.
# The CURRENT model under test is sly-official/heretic-mxfp4.env (official recipe + DFlash2 +
# 262144 window) — the matrix is docs/vllm/versions.md; every flag is explained in
# docs/vllm/settings.md. Each line below: what-for / side-effect.
# ============================================================
# Model A: AMD Quark MXFP4 (W4A8: 4-bit weights, fp8 activations on gfx1201's fp8 WMMA).
# Env set = README quickstart verbatim (src/v1.6.0/README.md). CLAIMED there: 149.6 tok/s decode
# WITH the DFlash2 drafter at 0.98 util -- not comparable to this drafter-off profile.
MODEL_DIR=${MODEL_DIR:-$VLLM_ROOT/models/amd__Qwen3.8-27B-Quark-AWQ-MXFP4@5233554c}
SERVED_NAME=${SERVED_NAME:-qwen38-27b-mxfp4}
MAXLEN=${MAXLEN:-150000}   # user cap for testing (2026-10-22); README recipe uses 262144

MODEL_ENV=(
  # MXFP4 kernel family (W4A8): 4-bit weights, fp8 activations on gfx1201's fp8 WMMA.
  #   RADIANCE_MXFP4=1          enable the MXFP4 GEMM path (settings.md: RADIANCE_MXFP4)
  #   RADIANCE_MXFP4_W4A8=1     W4A8 = 4-bit weights + fp8 activations (settings.md)
  #   RADIANCE_MXFP4_W4A8_MIN_M=0    allow W4A8 down to any M (small batches)
  #   RADIANCE_MXFP4_DECODE_MAX_M=128  decode-side W4A8 up to M=128
  #   RADIANCE_MXFP4_A_TILED_MIN_M=513 A-tiled GEMM only above M=513 (prefill); side-effect:
  #                                   the A-tiled kernel is the one that faulted historically (historical.md)
  #   RADIANCE_MXFP4_WPERM=1    weight permute for the WMMA path
  #   RADIANCE_LMHEAD_INT4=1    INT4 lm_head (smaller final projection)
  #   RADIANCE_FUSED_NORM_QUANT=1  fused norm+quant (one kernel)
  #   RADIANCE_KV_GROUP_SIZE=8    KV group size (fp8 KV scaling)
  #   RADIANCE_EMBED_INT8=1 RADIANCE_EMBED_BITS=4  INT8 / 4-bit embeddings
  #   RADIANCE_MXFP4_WIDE_MAX_M=192 RADIANCE_ADAPTIVE_WIDTH=perseq  wide adaptive-width GEMM
  RADIANCE_MXFP4=1 RADIANCE_MXFP4_W4A8=1 RADIANCE_MXFP4_W4A8_MIN_M=0
  RADIANCE_MXFP4_DECODE_MAX_M=128 RADIANCE_MXFP4_A_TILED_MIN_M=513 RADIANCE_MXFP4_WPERM=1
  RADIANCE_LMHEAD_INT4=1 RADIANCE_FUSED_NORM_QUANT=1
  RADIANCE_KV_GROUP_SIZE=8 RADIANCE_EMBED_INT8=1 RADIANCE_EMBED_BITS=4
  RADIANCE_MXFP4_WIDE_MAX_M=192 RADIANCE_ADAPTIVE_WIDTH=perseq
)
MODEL_ARGS=(--quantization quark)   # Quark checkpoint format (MXFP4 lives in the Quark config)
