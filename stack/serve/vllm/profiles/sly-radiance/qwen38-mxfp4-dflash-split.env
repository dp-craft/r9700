# qwen38-mxfp4-dflash, A-tiled OFF, + overlay (overlays/sly-pad-a) with RADIANCE_MXFP4_SPLIT_M=192: every prefill
# W4A8 GEMM runs as <=192-row slices on Sly's decode/wide kernels instead of the folded/atiled prefill kernels,
# which fault with a bit-44-cleared weight address (2026-10-22 ptrlog-4). Same weights, same W4A8 numerics.
source "$(dirname "${BASH_SOURCE[0]}")/qwen38-mxfp4-dflash-noatiled.env"
PY_OVERLAY=${PY_OVERLAY:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../overlays/sly-pad-a" && pwd)}
MODEL_ENV+=(RADIANCE_MXFP4_SPLIT_M=${SPLIT_M:-192} RADIANCE_MXFP4_PAD_A=0 RADIANCE_MXFP4_PAD_OUT_ROWS=0)
