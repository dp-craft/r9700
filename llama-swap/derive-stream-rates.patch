+func TestServer_SSELineCarriesToken(t *testing.T) {
+	tests := []struct {
+		name string
+		line string
+		want bool
+	}{
+		{"anthropic thinking delta", `data: {"type":"content_block_delta","index":0,"delta":{"type":"thinking_delta","thinking":"hmm"}}`, true},
+		{"anthropic empty thinking delta", `data: {"type":"content_block_delta","index":0,"delta":{"type":"thinking_delta","thinking":""}}`, false},
+		{"anthropic text delta", `data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"hi"}}`, true},
+		{"anthropic tool input delta", `data: {"type":"content_block_delta","index":0,"delta":{"type":"input_json_delta","partial_json":"{\"a\":"}}`, true},
+		{"anthropic signature delta", `data: {"type":"content_block_delta","index":0,"delta":{"type":"signature_delta","signature":""}}`, false},
+		{"anthropic message start", `data: {"type":"message_start","message":{"usage":{"input_tokens":4}}}`, false},
+		{"openai content delta", `data: {"choices":[{"index":0,"delta":{"content":"hi"}}]}`, true},
+		{"openai reasoning delta", `data: {"choices":[{"index":0,"delta":{"reasoning_content":"hmm"}}]}`, true},
+		{"openai role only", `data: {"choices":[{"index":0,"delta":{"role":"assistant"}}]}`, false},
+		{"done", "data: [DONE]", false},
+		{"event line", "event: content_block_delta", false},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := sseLineCarriesToken([]byte(test.line)); got != test.want {
+				t.Fatalf("sseLineCarriesToken() = %v, want %v", got, test.want)
+			}
+		})
+	}
+}
