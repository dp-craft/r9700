+// trackSSETokens notes when the first and last streamed token lines arrive, for
+// backends that report token counts but no rates (llama.cpp's Anthropic
+// /v1/messages). Lines are reassembled across Write calls; only the partial
+// tail is retained.
+func (w *responseBodyCopier) trackSSETokens(b []byte) {
+	if !w.sseChecked {
+		w.sseChecked = true
+		w.sseTracking = strings.Contains(w.Header().Get("Content-Type"), "text/event-stream")
+	}
+	if !w.sseTracking {
+		return
+	}
+	w.sseLineBuf = append(w.sseLineBuf, b...)
+	for {
+		i := bytes.IndexByte(w.sseLineBuf, '\n')
+		if i < 0 {
+			break
+		}
+		line := w.sseLineBuf[:i]
+		w.sseLineBuf = w.sseLineBuf[i+1:]
+		if sseLineCarriesToken(line) {
+			now := time.Now()
+			if w.firstTokenAt.IsZero() {
+				w.firstTokenAt = now
+			}
+			w.lastTokenAt = now
+		}
+	}
+}
+
+// sseLineCarriesToken reports whether one SSE line carries a generated token:
+// an Anthropic content_block_delta with non-empty thinking/text/tool input, or
+// an OpenAI chunk with a non-empty content/reasoning delta.
+func sseLineCarriesToken(line []byte) bool {
+	line = bytes.TrimSpace(line)
+	if !bytes.HasPrefix(line, []byte("data:")) {
+		return false
+	}
+	data := bytes.TrimSpace(line[len("data:"):])
+	if len(data) == 0 || bytes.Equal(data, []byte("[DONE]")) || !bytes.Contains(data, []byte("delta")) {
+		return false
+	}
+	parsed := gjson.ParseBytes(data)
+	if dt := parsed.Get("delta.type").String(); dt != "" {
+		switch dt {
+		case "thinking_delta", "text_delta":
+			return parsed.Get("delta.thinking").String() != "" || parsed.Get("delta.text").String() != ""
+		case "input_json_delta":
+			return parsed.Get("delta.partial_json").String() != ""
+		}
+		return false
+	}
+	for _, c := range parsed.Get("choices").Array() {
+		d := c.Get("delta")
+		if d.Get("content").String() != "" || d.Get("reasoning_content").String() != "" {
+			return true
+		}
+	}
+	return false
+}
