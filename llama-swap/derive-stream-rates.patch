+func TestServer_DeriveStreamRates_Anthropic(t *testing.T) {
+	start := time.Now().Add(-10 * time.Second)
+	rec := &responseBodyCopier{start: start, firstTokenAt: start.Add(2 * time.Second), lastTokenAt: start.Add(9 * time.Second)}
+	// Anthropic input_tokens exclude cached tokens (589 new of 61920 total).
+	tm := ActivityLogEntry{Tokens: TokenMetrics{InputTokens: 589, OutputTokens: 400, CachedTokens: 61331, PromptPerSecond: -1, TokensPerSecond: -1}}
+	deriveStreamRates(&tm, "/v1/messages", rec)
+	if got, want := tm.Tokens.PromptPerSecond, 589/2.0; math.Abs(got-want) > 1e-9 {
+		t.Errorf("PromptPerSecond = %v, want %v", got, want)
+	}
+	if got, want := tm.Tokens.TokensPerSecond, 399/7.0; math.Abs(got-want) > 1e-9 {
+		t.Errorf("TokensPerSecond = %v, want %v", got, want)
+	}
+}
