+// No observed token lines means nothing to derive from: rates stay unset and
+// backend-reported rates are never overridden.
+func TestServer_DeriveStreamRates_NoClockAndNoOverride(t *testing.T) {
+	rec := &responseBodyCopier{start: time.Now()}
+	tm := ActivityLogEntry{Tokens: TokenMetrics{InputTokens: 10, OutputTokens: 5, PromptPerSecond: -1, TokensPerSecond: -1}}
+	deriveStreamRates(&tm, "/v1/messages", rec)
+	if tm.Tokens.PromptPerSecond != -1 || tm.Tokens.TokensPerSecond != -1 {
+		t.Fatalf("rates = %+v, want unchanged -1/-1", tm.Tokens)
+	}
+
+	start := time.Now().Add(-5 * time.Second)
+	rec2 := &responseBodyCopier{start: start, firstTokenAt: start.Add(time.Second), lastTokenAt: start.Add(4 * time.Second)}
+	tm2 := ActivityLogEntry{Tokens: TokenMetrics{InputTokens: 10, OutputTokens: 5, PromptPerSecond: 42, TokensPerSecond: 17}}
+	deriveStreamRates(&tm2, "/v1/messages", rec2)
+	if tm2.Tokens.PromptPerSecond != 42 || tm2.Tokens.TokensPerSecond != 17 {
+		t.Fatalf("rates = %+v, want reported values kept", tm2.Tokens)
+	}
+}
