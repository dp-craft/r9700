+// deriveStreamRates fills prefill/decode rates the backend did not report, from
+// the token arrival times observed while proxying the stream. llama.cpp's
+// Anthropic /v1/messages endpoint sends token counts but no timings object, so
+// without this those requests record "unknown" rates. The values are
+// approximations (the prefill window includes queueing and model load; the
+// decode span runs first-to-last token), like the browser-measured stats in
+// the chat view. Rates the backend did report are never overridden.
+func deriveStreamRates(tm *ActivityLogEntry, path string, recorder *responseBodyCopier) {
+	first, last := recorder.FirstTokenAt(), recorder.LastTokenAt()
+	if first.IsZero() {
+		return
+	}
+	// Anthropic usage input_tokens already exclude cached tokens; OpenAI
+	// prompt_tokens include them.
+	anthropic := strings.HasSuffix(path, "/v1/messages")
+	if tm.Tokens.PromptPerSecond < 0 {
+		ttft := first.Sub(recorder.StartTime())
+		newTokens := tm.Tokens.InputTokens
+		if !anthropic && tm.Tokens.CachedTokens >= 0 {
+			newTokens -= tm.Tokens.CachedTokens
+		}
+		if ttft > 0 && newTokens > 0 {
+			tm.Tokens.PromptPerSecond = float64(newTokens) / ttft.Seconds()
+		}
+	}
+	if tm.Tokens.TokensPerSecond < 0 {
+		gen := last.Sub(first)
+		if gen > 0 && tm.Tokens.OutputTokens > 1 {
+			tm.Tokens.TokensPerSecond = float64(tm.Tokens.OutputTokens-1) / gen.Seconds()
+		}
+	}
+}
